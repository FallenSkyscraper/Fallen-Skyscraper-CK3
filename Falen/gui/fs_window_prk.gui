window = {
	name = "prk_window"
	parentanchor = center
	position = { 50 30 }
	size = { 1160 700 }
	layer = windows_layer
	filter_mouse = all
	alwaystransparent = no
	using = Window_Background
	using = Window_Decoration
	movable = yes
	visible = "[GetPlayer.MakeScope.Var('prk_gui_toggle').IsSet]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
		on_start = "[GetScriptedGui('prk_get_president').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetScriptedGui('prk_candidate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
		on_start = "[GetScriptedGui('prk_clear_list').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	vbox = {
		margin = { 14 12 }
		spacing = 7

		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" {
				text = "PRK_VIEW_TITLE"
				parentanchor = center
			}
			blockoverride "button_close" {
				datacontext = "[GetScriptedGui('prk_gui_close')]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 150 }
			spacing = 12

			vbox = {
				size = { 210 145 }
				margin = { 8 6 }
				using = Background_Area_Dark
				text_single_big = { text = "PRK_CURRENT_PRESIDENT" }
				datacontext = "[GetPlayer.MakeScope.Var('prk_president').GetCharacter]"
				portrait_head_small = {}
				text_single = {
					text = "[Character.GetFirstNameNicknamedNoTooltip]"
					max_width = 190
					autoresize = yes
				}
			}

			icon = {
				texture = "gfx/interface/gui/peoples_republic_korea.dds"
				size = { 200 150 }
			}

			vbox = {
				size = { 280 145 }
				margin = { 8 8 }
				spacing = 4
				using = Background_Area_Dark
				text_single_big = { text = "PRK_NEXT_ELECTION" }
				text_single_large = { text = "PRK_ELECTION_DATE" }
				text_single = { text = "PRK_ELECTION_UNTIL" }
				text_single_big = { text = "PRK_ELECTION_COUNTDOWN" }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 65 }
			margin = { 50 7 }
			spacing = 3
			using = Background_Area_Dark
			text_single_big = { text = "PRK_ELECTORATE_SUMMARY" layoutpolicy_horizontal = expanding }
			text_single = {
				text = "PRK_ELECTORATE_FORMULA"
				layoutpolicy_horizontal = expanding
				default_format = "#weak"
			}
		}

		hbox = {
		#	layoutpolicy_horizontal = expanding
			margin_top = -200
			minimumsize = { 0 290 }
			spacing = 160

			vbox = {
				size = { 700 280 }
				spacing = 4
				text_single_large = { text = "PRK_CANDIDATES" layoutpolicy_horizontal = expanding }
				text_single = {
					text = "PRK_CANDIDATE_LIST_HINT"
					layoutpolicy_horizontal = expanding
					default_format = "#weak"
				}
				text_single = {
					visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('fs_prk_ui_candidates'))]"
					text = "PRK_NO_CANDIDATES"
					layoutpolicy_horizontal = expanding
					default_format = "#weak"
				}

				scrollarea = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 200 }
					scrollbarpolicy_vertical = always_off
					scrollbarpolicy_horizontal = as_needed
					scrollbar_horizontal = { using = Scrollbar_Horizontal }
					scrollwidget = {
						hbox = {
							using = Scrollbox_Margins
							spacing = 10
							datamodel = "[GetPlayer.MakeScope.GetList('fs_prk_ui_candidates')]"
							item = {
								vbox = {
									datacontext = "[Scope.GetCharacter]"
									size = { 430 190 }
									margin = { 9 8 }
									spacing = 3
									using = Background_Area_Dark
									hbox = {
										minimumsize = { 0 95 }
										spacing = 8
										portrait_head_small = {}
										vbox = {
											text_single = { text = "[Character.GetFullNameNicknamedNoTooltip]" max_width = 305 autoresize = yes }
											text_single = { text = "PRK_CANDIDATE_IDENTITY" max_width = 305 autoresize = yes }
											text_single = { text = "PRK_CANDIDATE_SKILLS" max_width = 305 autoresize = yes }
											text_single = { text = "PRK_CANDIDATE_STANDING" max_width = 305 autoresize = yes }
											text_single = { text = "PRK_CANDIDATE_PLAYER_OPINION" max_width = 305 autoresize = yes }
										}
									}
									text_single = {
										text = "PRK_EXPECTED_AI_SUPPORT"
										tooltip = "PRK_EXPECTED_SUPPORT_TOOLTIP"
										using = tooltip_se
									}
									text_single = { text = "PRK_CANDIDATE_ELECTORAL_VOTES" default_format = "#weak" }
								}
							}
							expand = {}
						}
					}
				}
			}

			vbox = {
				size = { 410 280 }
				spacing = 4
				text_single_large = { text = "PRK_ELECTOR_BREAKDOWN_TITLE" layoutpolicy_horizontal = expanding }
				text_single = {
					text = "PRK_ELECTOR_BREAKDOWN_HINT"
					layoutpolicy_horizontal = expanding
					default_format = "#weak"
					max_width = 400
					autoresize = yes
				}
				scrollarea = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 220 }
					scrollbarpolicy_horizontal = always_off
					scrollbarpolicy_vertical = as_needed
					scrollbar_vertical = { using = Scrollbar_Vertical }
					scrollwidget = {
						vbox = {
							using = Scrollbox_Margins
							spacing = 7
							datamodel = "[GetPlayer.MakeScope.GetList('fs_prk_ui_electors')]"
							item = {
								hbox = {
									datacontext = "[Scope.GetCharacter]"
									size = { 370 105 }
									margin = { 7 6 }
									spacing = 7
									using = Background_Area_Dark
									portrait_head_small = {}
									vbox = {
										spacing = 5
										text_single = { text = "[Character.GetFullNameNicknamedNoTooltip]" max_width = 265 autoresize = yes }
										text_single = { text = "PRK_ELECTOR_VOTE_BREAKDOWN" max_width = 265 autoresize = yes }
									}
								}
							}
							expand = {}
						}
					}
				}
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 36 }
			spacing = 12
			expand = {}
			button_standard = {
				name = "run_candidate"
				size = { 150 32 }
				datacontext = "[GetScriptedGui('prk_run_candidate')]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "RUN_CANDIDATE_TOOLTIP"
				using = tooltip_se
				text_single = { text = "PRK_RUN_CANDIDATE" align = center|nobaseline parentanchor = center }
			}
			button_standard = {
				name = "resign_candidate"
				size = { 150 32 }
				datacontext = "[GetScriptedGui('prk_resign_candidate')]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "RESIGN_CANDIDATE_TOOLTIP"
				using = tooltip_se
				text_single = { text = "PRK_RESIGN_CANDIDATE" align = center|nobaseline parentanchor = center }
			}
			expand = {}
		}
	}
}
