window = {
	name = "prk_window"
	parentanchor = center
	position = { 50 50 }
	size = { 1160 900 }
	layer = windows_layer
	filter_mouse = all
	alwaystransparent = no
	using = Window_Background
	using = Window_Decoration
	movable = yes
	visible = "[GetPlayer.MakeScope.Var('prk_gui_toggle').IsSet]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
		on_start = "[GetScriptedGui('prk_get_president').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
		on_start = "[GetScriptedGui('prk_candidate').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
		on_start = "[GetScriptedGui('prk_clear_list').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	vbox = {
		margin = { 10 10 }
		spacing = 7

		header_pattern = {
			layoutpolicy_horizontal = expanding
			blockoverride "header_text" {
				text = "PRK_VIEW_TITLE"
				margin = { -10 0 }
				parentanchor = center
			}
			blockoverride "button_close" {
				datacontext = "[GetScriptedGui('prk_gui_close')]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
			}
		}

		hbox = {
			using = Window_Margins
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 165 }
			spacing = 12

			vbox = {
				size = { 210 160 }
				margin = { 8 8 }
				using = Background_Area_Dark
				text_single_big = { text = "PRK_CURRENT_PRESIDENT" }
				datacontext = "[GetPlayer.MakeScope.Var('prk_president').GetCharacter]"
				portrait_head_small = {}
				text_single = {
					text = "[Character.GetFirstNameNicknamedNoTooltip]"
					max_width = 190
					autoresize = yes
				}
			}

			icon = {
				texture = "gfx/interface/gui/peoples_republic_korea.dds"
				size = { 600 160 }
			}

			vbox = {
				size = { 280 160 }
				margin = { 8 8 }
				spacing = 4
				using = Background_Area_Dark
				text_single_big = { text = "PRK_NEXT_ELECTION" }
				text_single_large = { text = "PRK_ELECTION_DATE" }
				text_single = { text = "PRK_ELECTION_UNTIL" }
				text_single_big = { text = "PRK_ELECTION_COUNTDOWN" }
			}
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 65 }
			margin = { 10 8 }
			spacing = 4
			using = Background_Area_Dark
			text_single_big = {
				text = "PRK_ELECTORATE_SUMMARY"
				layoutpolicy_horizontal = expanding
			}
			text_single = {
				text = "PRK_ELECTORATE_FORMULA"
				layoutpolicy_horizontal = expanding
				default_format = "#weak"
			}
		}

		text_single_large = {
			text = "PRK_CANDIDATES"
			layoutpolicy_horizontal = expanding
		}
		text_single = {
			text = "PRK_CANDIDATE_LIST_HINT"
			layoutpolicy_horizontal = expanding
			default_format = "#weak"
		}
		text_single = {
			visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('fs_prk_ui_candidates'))]"
			text = "PRK_NO_CANDIDATES"
			layoutpolicy_horizontal = expanding
			default_format = "#weak"
		}

		scrollarea = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 295 }
			scrollbarpolicy_vertical = always_off
			scrollbarpolicy_horizontal = as_needed
			scrollbar_horizontal = { using = Scrollbar_Horizontal }

			scrollwidget = {
				hbox = {
					using = Scrollbox_Margins
					spacing = 10
					datamodel = "[GetPlayer.MakeScope.GetList('fs_prk_ui_candidates')]"
					item = {
						vbox = {
							datacontext = "[Scope.GetCharacter]"
							size = { 245 275 }
							margin = { 9 8 }
							spacing = 3
							using = Background_Area_Dark
							portrait_head_small = {}
							text_single = {
								text = "[Character.GetFullNameNicknamedNoTooltip]"
								max_width = 225
								autoresize = yes
							}
							text_single = { text = "PRK_CANDIDATE_IDENTITY" max_width = 225 autoresize = yes }
							text_single = { text = "PRK_CANDIDATE_SKILLS" max_width = 225 autoresize = yes }
							text_single = { text = "PRK_CANDIDATE_STANDING" max_width = 225 autoresize = yes }
							text_single = { text = "PRK_CANDIDATE_PLAYER_OPINION" max_width = 225 autoresize = yes }
							text_single = {
								text = "PRK_EXPECTED_AI_SUPPORT"
								tooltip = "PRK_EXPECTED_SUPPORT_TOOLTIP"
								using = tooltip_se
							}
							text_single = { text = "PRK_CANDIDATE_ELECTORAL_VOTES" default_format = "#weak" }
						}
					}
				}
			}
		}

		text_single_large = {
			text = "PRK_ELECTOR_BREAKDOWN_TITLE"
			layoutpolicy_horizontal = expanding
		}
		text_single = {
			text = "PRK_ELECTOR_BREAKDOWN_HINT"
			layoutpolicy_horizontal = expanding
			default_format = "#weak"
		}
		scrollarea = {
			layoutpolicy_horizontal = expanding
			minimumsize = { 0 130 }
			scrollbarpolicy_vertical = always_off
			scrollbarpolicy_horizontal = as_needed
			scrollbar_horizontal = { using = Scrollbar_Horizontal }
			scrollwidget = {
				hbox = {
					using = Scrollbox_Margins
					spacing = 8
					datamodel = "[GetPlayer.MakeScope.GetList('fs_prk_ui_electors')]"
					item = {
						hbox = {
							datacontext = "[Scope.GetCharacter]"
							size = { 260 115 }
							margin = { 7 6 }
							spacing = 7
							using = Background_Area_Dark
							portrait_head_small = {}
							vbox = {
								text_single = {
									text = "[Character.GetFullNameNicknamedNoTooltip]"
									max_width = 175
									autoresize = yes
								}
								text_single = { text = "PRK_ELECTOR_VOTE_BREAKDOWN" max_width = 175 autoresize = yes }
							}
						}
					}
				}
			}
		}

		hbox = {
			layoutpolicy_horizontal = expanding
			spacing = 12
			expand = {}
			button_standard = {
				name = "run_candidate"
				size = { 150 32 }
				datacontext = "[GetScriptedGui('prk_run_candidate')]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "RUN_CANDIDATE_TOOLTIP"
				using = tooltip_se
				text_single = { text = "PRK_RUN_CANDIDATE" align = center|nobaseline parentanchor = center }
			}
			button_standard = {
				name = "resign_candidate"
				size = { 150 32 }
				datacontext = "[GetScriptedGui('prk_resign_candidate')]"
				enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				tooltip = "RESIGN_CANDIDATE_TOOLTIP"
				using = tooltip_se
				text_single = { text = "PRK_RESIGN_CANDIDATE" align = center|nobaseline parentanchor = center }
			}
			expand = {}
		}
	}
}
