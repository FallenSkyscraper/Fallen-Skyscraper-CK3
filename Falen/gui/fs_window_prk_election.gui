window = {
	name = "election_window"
	parentanchor = center
	position = { 50 30 }
	size = { 1160 740 }
	layer = windows_layer
	filter_mouse = all
	alwaystransparent = no
	using = Window_Background
	using = Window_Decoration
	movable = yes
	visible = "[GetScriptedGui('fs_prk_election_gui_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
		on_start = "[GetScriptedGui('fs_prk_election_candidate_list').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
		on_start = "[GetScriptedGui('fs_prk_clear_election_candidate_list').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}

	widget = {
		size = { 100% 100% }
		using = Window_Margins
		background = {
			texture = "gfx/interface/gui/background_peoples_republic_korea.dds"
			spriteType = Corneredtiled
			spriteborder = { 18 0 }
			texture_density = 2
			modify_texture = {
				texture = "gfx/interface/component_overlay/overlay_effect.dds"
				blend_mode = overlay
			}
		}
		margin_top = -5
		margin_bottom = 5

		vbox = {
			margin = { 14 12 }
			spacing = 6

			header_standard = {
				layoutpolicy_horizontal = expanding
				blockoverride "header_text" {
					text = "PRK_ELECTION_TITLE"
					parentanchor = center
				}
				blockoverride "button_close" { visible = "[Not(GetPlayer.IsValid)]" }
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 112 }
				margin = { 12 8 }
				spacing = 3
				using = Background_Area_Dark
				text_single_big = { text = "PRK_MY_VOTES" layoutpolicy_horizontal = expanding }
				text_single = { text = "PRK_ELECTORATE_SUMMARY" layoutpolicy_horizontal = expanding }
				text_single = { text = "PRK_PENDING_VOTER_COUNT" layoutpolicy_horizontal = expanding }
				text_single = {
					text = "PRK_ELECTION_INSTRUCTIONS"
					layoutpolicy_horizontal = expanding
					default_format = "#weak"
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 48 }
				spacing = 8
				text_single_large = { text = "PRK_PENDING_VOTERS" }
				scrollarea = {
					layoutpolicy_horizontal = expanding
					minimumsize = { 0 42 }
					scrollbarpolicy_vertical = always_off
					scrollbarpolicy_horizontal = as_needed
					scrollbar_horizontal = { using = Scrollbar_Horizontal }
					scrollwidget = {
						hbox = {
							using = Scrollbox_Margins
							spacing = 7
							datamodel = "[GetPlayer.MakeScope.GetList('fs_prk_ui_pending_players')]"
							item = {
								text_single = {
									datacontext = "[Scope.GetCharacter]"
									size = { 190 32 }
									using = Background_Area_Dark
									text = "[Character.GetFullNameNicknamedNoTooltip]"
									max_width = 180
									autoresize = yes
								}
							}
							expand = {}
						}
					}
				}
			}

			text_single_large = { text = "PRK_CANDIDATES" layoutpolicy_horizontal = expanding }
			text_single = {
				text = "PRK_CANDIDATE_LIST_HINT"
				layoutpolicy_horizontal = expanding
				default_format = "#weak"
			}
			text_single = {
				visible = "[IsDataModelEmpty(GetPlayer.MakeScope.GetList('fs_prk_ui_election_candidates'))]"
				text = "PRK_NO_ELECTION_CANDIDATES"
				layoutpolicy_horizontal = expanding
				default_format = "#weak"
			}

			scrollarea = {
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 250 }
				scrollbarpolicy_vertical = always_off
				scrollbarpolicy_horizontal = as_needed
				scrollbar_horizontal = { using = Scrollbar_Horizontal }
				scrollwidget = {
					hbox = {
						using = Scrollbox_Margins
						spacing = 10
						datamodel = "[GetPlayer.MakeScope.GetList('fs_prk_ui_election_candidates')]"
						item = {
							vbox = {
								datacontext = "[Scope.GetCharacter]"
								size = { 450 230 }
								margin = { 10 8 }
								spacing = 3
								using = Background_Area_Dark
								hbox = {
									minimumsize = { 0 95 }
									spacing = 8
									portrait_head_small = {}
									vbox = {
										text_single = { text = "[Character.GetFullNameNicknamedNoTooltip]" max_width = 325 autoresize = yes }
										text_single = { text = "PRK_CANDIDATE_IDENTITY" max_width = 325 autoresize = yes }
										text_single = { text = "PRK_CANDIDATE_SKILLS" max_width = 325 autoresize = yes }
										text_single = { text = "PRK_CANDIDATE_STANDING" max_width = 325 autoresize = yes }
										text_single = { text = "PRK_CANDIDATE_PLAYER_OPINION" max_width = 325 autoresize = yes }
									}
								}
								text_single = {
									text = "PRK_EXPECTED_AI_SUPPORT"
									tooltip = "PRK_EXPECTED_SUPPORT_TOOLTIP"
									using = tooltip_se
								}
								text_single = { text = "PRK_CURRENT_RECORDED_VOTES" }
								text_single = { text = "PRK_CANDIDATE_ELECTORAL_VOTES" default_format = "#weak" }
								button_standard = {
									size = { 115 32 }
									using = Background_Area_Light
									enabled = "[GetScriptedGui('voting').IsValid(GuiScope.SetRoot(Character.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
									onclick = "[GetScriptedGui('voting').Execute(GuiScope.SetRoot(Character.MakeScope).AddScope('player',GetPlayer.MakeScope).End)]"
									tooltip = "PRK_VOTE_TOOLTIP"
									using = tooltip_se
									text_single = { text = "PRK_VOTE" align = center|nobaseline parentanchor = center }
								}
							}
						}
						expand = {}
					}
				}
			}

			vbox = {
				visible = "[GetScriptedGui('fs_prk_vote_confirmation_candidate').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 78 }
				margin = { 10 7 }
				spacing = 4
				using = Background_Area_Light
				text_single_big = { text = "PRK_CONFIRM_VOTE_TEXT" layoutpolicy_horizontal = expanding }
				text_single = { text = "PRK_CONFIRM_SELECTION_WARNING" layoutpolicy_horizontal = expanding }
				hbox = {
					layoutpolicy_horizontal = expanding
					expand = {}
					button_standard = {
						size = { 120 30 }
						datacontext = "[GetScriptedGui('fs_prk_confirm_vote')]"
						enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text_single = { text = "PRK_CONFIRM" align = center|nobaseline parentanchor = center }
					}
					button_standard = {
						size = { 120 30 }
						datacontext = "[GetScriptedGui('fs_prk_cancel_vote_confirmation')]"
						enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text_single = { text = "PRK_CANCEL" align = center|nobaseline parentanchor = center }
					}
					expand = {}
				}
			}

			vbox = {
				visible = "[GetScriptedGui('fs_prk_vote_confirmation_abstention').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 78 }
				margin = { 10 7 }
				spacing = 4
				using = Background_Area_Light
				text_single_big = { text = "PRK_CONFIRM_ABSTENTION_TEXT" layoutpolicy_horizontal = expanding }
				text_single = { text = "PRK_CONFIRM_SELECTION_WARNING" layoutpolicy_horizontal = expanding }
				hbox = {
					layoutpolicy_horizontal = expanding
					expand = {}
					button_standard = {
						size = { 120 30 }
						datacontext = "[GetScriptedGui('fs_prk_confirm_abstention')]"
						enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text_single = { text = "PRK_CONFIRM" align = center|nobaseline parentanchor = center }
					}
					button_standard = {
						size = { 120 30 }
						datacontext = "[GetScriptedGui('fs_prk_cancel_vote_confirmation')]"
						enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
						text_single = { text = "PRK_CANCEL" align = center|nobaseline parentanchor = center }
					}
					expand = {}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				minimumsize = { 0 36 }
				expand = {}
				button_standard = {
					name = "abstain_vote"
					size = { 150 32 }
					datacontext = "[GetScriptedGui('voting_absent')]"
					enabled = "[ScriptedGui.IsValid(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
					tooltip = "PRK_ABSTAIN_TOOLTIP"
					using = tooltip_se
					text_single = { text = "PRK_ABSTAIN" align = center|nobaseline parentanchor = center }
				}
				expand = {}
			}
		}
	}
}
