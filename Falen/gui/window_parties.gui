window = {
	name = "parties_window"
	parentanchor = center
	position = { 50 100 }
	size = { 850 1000 }
	layer = windows_layer
	filter_mouse = all
	alwaystransparent = no
	using = Window_Background
	using = Window_Decoration
	movable = yes
	visible = "[GetScriptedGui('party_gui_toggle').IsShown(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	
	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		using = Window_Position_MainTab
		
		#on_start = "[GetScriptedGui('zz').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
	}
	
	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		using = Window_Position_MainTab_Hide
	
	}
	widget = {
		size = { 100% 100% }
		using = Window_Margins
		margin_top = -5
		margin_bottom = 5

		vbox = {
			header_standard = {
				using = Window_Margins
				margin_bottom = 30
				layoutpolicy_horizontal = expanding								
				blockoverride "header_text"
				{
					text = "PARTIES_LIST"
					margin = { -10 0 }
					parentanchor = center
				}
				blockoverride "button_close"
				{
					datacontext = "[GetScriptedGui('party_gui_close')]"
					onclick = "[ScriptedGui.Execute(GuiScope.SetRoot(GetPlayer.MakeScope).End)]"
				}
			}
			scrollarea = {
				flowcontainer = {
					ignoreinvisible = yes
					direction = vertical
					datamodel = "[GetGlobalList('parties_list')]"
					item = {
						flowcontainer = {
							datacontext = "[Scope.Title]"
							direction = horizontal
							coa_title_small_crown = {
								using = tooltip_ne
							}
							vbox = {
								portrait_head_small = { datacontext = "[Title.GetHolder]" }
								text_single_big = { text = "[Title.GetNameNoTooltip]" }
							}
						}
					}
				}
			}
		}
	}
}