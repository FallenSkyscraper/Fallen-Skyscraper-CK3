	type widget_market_tolls_tooltip = object_tooltip_pop_out {

		blockoverride "header_additions" {
			hbox = {
				margin_right = 10
				margin_top = 2
				margin_left = -4
				spacing = 8

				icon = {
					size = { 32 32 }
					texture = "gfx/interface/icons/trade/icon_toll.dds"
					tintcolor = "[TooltipInfo.GetTintColor]"
				}

				text_single = {
					text = "TOLL_LEVEL_MARKET_TOLL"
					default_format = "#T"
					align = nobaseline
					using = Font_Size_Medium
					fonttintcolor = "[TooltipInfo.GetTintColor]"
				}

				block "toll_name" {
					text_single = {
						visible = "[Not( TradeMarket.IsCharacterExemptFromTolls( Character.Self ))]"
						text = "[TollLevel.GetName]"
						align = nobaseline
						using = Font_Size_Medium
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}

					text_single = {
						visible = "[TradeMarket.IsCharacterExemptFromTolls( Character.Self )]"
						text = "TOLL_EXEMPT_FROM_TOLLS"
						align = nobaseline
						using = Font_Size_Medium
						fonttintcolor = "[TooltipInfo.GetTintColor]"
					}
				}
			}
		}

		blockoverride "title_text" {}

		blockoverride "subheading" {}

		blockoverride "concept_link" {}

		blockoverride "main_description" {
			vbox = {
				layoutpolicy_horizontal = expanding
				spacing = 4
				margin_top = 4

				block toll_tooltip_content {
					cooltip_paragraph = {
						visible = "[TradeMarket.IsCharacterExemptFromTolls( Character.Self )]"
						text = "[TradeMarket.GetExemptionReason( Character.Self )]"
					}

					cooltip_paragraph = {
						visible = "[Not( TradeMarket.IsCharacterExemptFromTolls( Character.Self ))]"
						text = "TOLL_EFFECT_ROUTE_OWNER"
					}

					cooltip_paragraph = {
						visible = "[Not( TradeMarket.IsCharacterExemptFromTolls( Character.Self ))]"
						text = "TOLL_EFFECT_MARKET_OWNER"
					}
				}
			}
		}
	}

	type widget_market_tolls_tooltip_main_window = widget_market_tolls_tooltip {
		blockoverride "toll_name" {
			text_single = {
				text = "[TollLevel.GetName]"
				align = nobaseline
				using = Font_Size_Medium
				fonttintcolor = "[TooltipInfo.GetTintColor]"
			}
		}

		blockoverride "toll_tooltip_content" {

			vbox = {
				visible = "[And( CanPlayerUseProfitMode, Character.IsLocalPlayer )]"
				layoutpolicy_horizontal = growing

				cooltip_paragraph = {
					visible = "[And( TradeMarket.CharacterHasTollException( Character.Self ), Not( TradeMarket.IsCharacterExemptFromTolls( Character.Self )))]"
					datacontext = "[TradeMarket.GetTollLevelForCharacter( Character.Self )]"
					text = "TOLL_EFFECT_TOLL_EXCEPTION"
				}

				cooltip_paragraph = {
					visible = "[TradeMarket.IsCharacterExemptFromTolls( Character.Self )]"
					text = "TOLL_EFFECT_TOLL_EXEMPTION"
				}

				spacer = {
					visible = "[Or( TradeMarket.CharacterHasTollException( Character.Self ), TradeMarket.IsCharacterExemptFromTolls( Character.Self ))]"
					size = { 0 10 }
				}
			}

			cooltip_paragraph = {
				text = "TOLL_EFFECT_ROUTE_OWNER"
			}

			cooltip_paragraph = {
				text = "TOLL_EFFECT_MARKET_OWNER"
			}
		}
	}

	type button_trade_market_good = button_standard {
		size = { 72 30 }
		onclick = "[TradeMarketWindow.SetSelectedTradeGoodType( TradeGoodType.Self )]"
		onclick = "[TradeGoodType.PlaySelectSound]"
		onclick = "[PdxGuiTriggerAllAnimations('market_window_refresh')]"

		down = "[ObjectsEqual( TradeGoodType.Self, TradeMarketWindow.GetSelectedTradeGoodType )]"
		upframe = 3 # to downplay needs you don't have

		alpha = "[Select_float( And( Not( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ) ), Not( ObjectsEqual( TradeGoodType.Self, TradeMarketWindow.GetSelectedTradeGoodType ) ) ),'(float)0.4','(float)1.0')]"

		tooltip_visible = "[Not( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ) )]"
		tooltipwidget = {
			container = {
				alwaystransparent = no
				object_tooltip_pop_out = {
					blockoverride "concept_link" {
						text = "[trade_good|E]"
					}

					blockoverride "header_additions"
					{
						hbox = {
							margin_right = 10

							icon = {
								size = { 40 40 }
								texture = "[TradeGoodType.GetIcon]"
							}
						}
					}

					blockoverride "title_text" {
						text = "[TradeGoodType.GetNameNoTooltip]"
						default_format = "#T"
					}

					blockoverride "extra_data" {
						text_multi = {
							autoresize = yes
							max_width = 350
							align = nobaseline
							margin = { 2 5 }
							text = "TRADE_GOOD_NOT_IN_MARKET"
							default_format = "#weak"
						}
					}

					blockoverride "input_info_text" {
						text = "CLICK_TO_SELECT"
					}
				}
			}
		}

		button_standard = {
			visible = "[TradeMarketWindow.IsGoodNeededByPlayerHoldings( TradeGoodType.Self )]"
			size = { 100% 100% }
			alwaystransparent = yes
			down = "[ObjectsEqual( TradeGoodType.Self, TradeMarketWindow.GetSelectedTradeGoodType )]"

			icon = {
				visible = "[TradeMarketWindow.HasPlayerUnmetNeedsForGood( TradeGoodType.Self )]"
				texture = "gfx/interface/colors/white.dds"
				parentanchor = center
				size = { 102% 102% }
				using = Mask_Rough_Edges
				alpha = 0.4

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_edge_inverted.dds"
					blend_mode = alphaMultiply
				}
			}
		}

		flowcontainer = {
			datacontext = "[TradeMarketWindow.GetGoodBalanceItem( TradeGoodType.Self )]"
			parentanchor = center
			spacing = 4
			ignoreinvisible = yes
			tooltip_visible = "[TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self )]"

			tooltipwidget = {
				widget_trade_good_net_balance_breakdown_tooltip = {
					blockoverride "balance_header_text" {
						text = "TRADE_MARKET_BALANCE_TT_HEADER_MODE"
						default_format = "#T"
					}

					blockoverride "distribution_imports_value" {
						text = "MARKET_GOOD_BALANCE_DISTRIBUTION_IMPORTS_VALUE"

						tooltipwidget = {
							widget_value_breakdown_tooltip = {
								datacontext = "[TradeMarketWindow.GetDistributionImportsBreakdownTooltip( TradeMarketGood.Self )]"
							}
						}
					}

					blockoverride "distribution_exports_value" {
						text = "MARKET_GOOD_BALANCE_DISTRIBUTION_EXPORTS_VALUE"

						tooltipwidget = {
							widget_value_breakdown_tooltip = {
								datacontext = "[TradeMarketWindow.GetDistributionExportsBreakdownTooltip( TradeMarketGood.Self )]"
							}
						}
					}

					blockoverride "entrepot_excluded_dimming" {
						alpha = "[Select_float( TradeMarketWindow.IsNetBalanceMode, '(float)0.5', '(float)1.0' )]"
						tooltip_visible = "[TradeMarketWindow.IsNetBalanceMode]"
					}

					blockoverride "category_use_visible" {
						visible = "[GreaterThan_CFixedPoint( TradeMarketWindow.GetCategoryUseForGood( TradeGoodType.Self ), '(CFixedPoint)0' )]"
					}

					blockoverride "category_use_value" {
						text = "MARKET_GOOD_BALANCE_CATEGORY_USE_VALUE"
					}

					blockoverride "unmet_needs_section" {
						vbox = {
							visible = "[TradeMarketWindow.HasPlayerUnmetNeedsForGood( TradeGoodType.Self )]"
							layoutpolicy_horizontal = expanding
							spacing = 2
							margin_top = 4

							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 6

								background = {
									using = Background_Area_Characterlist
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "MARKET_GOOD_UNMET_NEEDS_TITLE"
									align = nobaseline
								}
							}

							vbox = {
								datamodel = "[TradeMarketWindow.GetPlayerUnmetNeedsForGood( TradeGoodType.Self )]"
								layoutpolicy_horizontal = expanding
								spacing = 3

								item = {
									hbox = {
										layoutpolicy_horizontal = expanding
										spacing = 8
										margin = { 6 3 }
										datacontext = "[TradeMarketUnmetNeed.GetTitle]"

										background = {
											using = Background_Area_Characterlist
										}

										text_single = {
											size = { 40 25 }
											autoresize = no
											text = "[TradeMarketUnmetNeed.GetMarketPriority|O]"
											default_format = "#light_background"
											align = nobaseline|center

											using = Background_Letter_No_Frame

											tooltip = "HOLDING_MARKET_PRIORITY_TT"
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 8

											tooltipwidget = {
												widget_trade_market_holding_needs_tooltip = {}
											}

											text_single = {
												text = "[Title.GetNameNoTierNoTooltip]"
												align = nobaseline
											}

											expand = {}

											text_single = {
												text = "[TradeMarketUnmetNeed.GetTotalUnmet|1^]"
												align = nobaseline
												default_format = "#trade_need"
											}
										}
									}
								}
							}
						}
					}

					blockoverride "call_to_action" {
						text_single = {
							layoutpolicy_horizontal = expanding
							margin_top = -15
							margin_bottom = 10
							text = "CLICK_TO_SELECT"
						}
					}
				}
			}

			widget = {
				datacontext = "[TradeMarket.GetGoodMonopoly( TradeGoodType.Self )]"
				parentanchor = vcenter
				size = { 24 24 }

				widget = {
					visible = "[TradeMarket.GoodIsUnderMonopoly( TradeGoodType.Self )]"
					size = { 120% 120% }
					parentanchor = center

					tooltipwidget = {
						using = trade_monopoly_tooltip
					}

					icon = {
						visible = "[TradeMonopoly.IsExploitative]"
						size = { 100% 100% }
						texture = "gfx/interface/icons/trade/icon_trade_monopoly_exploitative_frame.dds"

					}

					icon = {
						visible = "[Not( TradeMonopoly.IsExploitative )]"
						size = { 100% 100% }
						texture = "gfx/interface/icons/trade/icon_trade_monopoly_frame.dds"
					}
				}

				icon = {
					size = { 100% 100%  }

					texture = "[TradeGoodType.GetSmallIcon]"

					modify_texture = {
						visible = "[And( Not( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ) ), Not( ObjectsEqual( TradeGoodType.Self, TradeMarketWindow.GetSelectedTradeGoodType ) ) )]"

						color = { 0.4 0.4 0.4 1 }
						blend_mode = normal
						alpha = 0.4
					}
				}

				container_monopoly_access = {}

				icon = {
					texture = "gfx/interface/icons/district_types_icons/entrepot_district.dds"
					visible = "[TradeMarket.HasEntrepotNeedForGood( TradeGoodType.Self )]"
					parentanchor = top|left
					tooltip = "TRADE_MAP_ICON_ENTREPOT_TT"
					size = { 12 12 }
					position = { -2 0 }

					modify_texture = {
						texture = "gfx/interface/colors/blue.dds"
					}

					modify_texture = {
						texture = "gfx/interface/colors/white.dds"
						alpha = 0.3
					}

					glow = {
						color = { 0 0 0 0.9 }
						glow_radius = 2
						using = Glow_Standard
					}
				}
			}

			text_single = {
				visible = "[And( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ), Not( And4( TradeMarketWindow.IsNetBalanceMode, GreaterThan_CFixedPoint( TradeMarketWindow.GetDisplayBalanceForGood( TradeGoodType.Self ), '(CFixedPoint)-0.1' ), LessThan_CFixedPoint( TradeMarketWindow.GetDisplayBalanceForGood( TradeGoodType.Self ), '(CFixedPoint)0.1' ), Not( TradeMarketWindow.HasUnmetNeedsForGood( TradeGoodType.Self ) ) ) ) )]"
				text = "[GetColoredValueString( TradeMarketWindow.GetDisplayBalanceForGood( TradeGoodType.Self ), 'trade', '(int32)0' )]"
				align = nobaseline
				parentanchor = vcenter
				alwaystransparent = yes
			}

			# Fulfilled balance: replaces a balance that would display as zero
			icon = {
				visible = "[And( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ), And4( TradeMarketWindow.IsNetBalanceMode, GreaterThan_CFixedPoint( TradeMarketWindow.GetDisplayBalanceForGood( TradeGoodType.Self ), '(CFixedPoint)-0.1' ), LessThan_CFixedPoint( TradeMarketWindow.GetDisplayBalanceForGood( TradeGoodType.Self ), '(CFixedPoint)0.1' ), Not( TradeMarketWindow.HasUnmetNeedsForGood( TradeGoodType.Self ) ) ) )]"
				parentanchor = vcenter
				size = { 20 20 }
				texture = "gfx/interface/icons/symbols/icon_check.dds"
				alwaystransparent = yes
			}
		}

		highlight_icon = {
			visible = "[TradeMarketWindow.IsPlayerTradingGoodInMarket( TradeGoodType.Self )]"
			size = { 100% 100% }
			texture = "gfx/interface/component_masks/mask_frame.dds"
			using = Color_Bright_Yellow
			alpha = 1.0
		}
	}

