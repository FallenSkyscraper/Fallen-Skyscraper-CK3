				alpha = 0.4
			}

			modify_texture = {
				texture = "gfx/interface/colors/colors_textured.dds"
				framesize = { 96 96 }
				frame = 9
				alpha = 1
			}
		}
	}

	# requires a character datacontext
	type hbox_market_toll = hbox {
		datacontext = "[TradeMarket.GetTollLevelForCharacter( Character.Self )]"

		block "toll_tooltip" {
			tooltipwidget = {
				widget_market_tolls_tooltip = {}
			}
		}

		icon = {
			size = { 26 26 }
			texture = "gfx/interface/icons/trade/icon_toll.dds"
			alwaystransparent = yes

			modify_texture = {
				visible = "[Or(Not( TradeMarket.CharacterHasTollException( Character.Self )), TradeMarket.IsCharacterExemptFromTolls( Character.Self ))]"

				color = { 0.4 0.4 0.4 1 }
				blend_mode = normal
				alpha = 0.5
			}
		}

		text_single = {
			visible = "[Not(TradeMarket.IsCharacterExemptFromTolls( Character.Self ))]"
			text = "[TollLevel.GetName]"
			align = nobaseline
			alwaystransparent = yes
			alpha = "[Select_float( TradeMarket.CharacterHasTollException( Character.Self ), '(float)1.0', '(float)0.5' )]"
		}

		text_single = {
			visible = "[TradeMarket.IsCharacterExemptFromTolls( Character.Self )]"
			text = "TOLL_EXEMPT_FROM_TOLLS"
			align = nobaseline
			alwaystransparent = yes
		}

		expand = {}
	}
}

template Animation_Market_Window_Refresh
{
	state = {
		name = market_window_refresh
		using = Animation_Refresh_FadeOut
	}

	state = {
		using = Animation_Refresh_FadeIn
		duration = 0.1
	}
}

