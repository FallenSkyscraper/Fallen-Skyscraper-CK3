#######################################################
#################   TRADE MARKET   ####################
#######################################################

window = {
	name = "trade_market_window"
	widgetid = "trade_market_window"
	datacontext = "[GetPlayer]"
	datacontext = "[TradeMarketWindow.GetMarket]"
	datacontext = "[TradeMarketWindow.GetTradeMarketMerchantsList]"
	datacontext = "[TradeMarketWindow.GetNeedsList]"
	datacontext = "[TradeMarketWindow.GetSelectedTradeGoodType]"

	allow_outside = yes
	movable = no
	layer = middle

	size = { 830 100% }
	using = Window_Background_Sidebar

	state = {
		name = _show
		using = Animation_FadeIn_Quick
		using = Sound_WindowShow_Standard
		position_x = 0
	}

	state = {
		name = _hide
		using = Animation_FadeOut_Quick
		using = Sound_WindowHide_Standard
		position_x = -60

		on_finish = "[GetVariableSystem.Clear( 'market_subwindow' )]"
	}

	vbox = {
		name = "main_content"
		layoutpolicy_horizontal = expanding
		layoutpolicy_vertical = expanding

		using = Window_Margins_Sidebar

		# Requested by the open_trade_market_trade_posts effect
		state = {
			name = open_requested_trade_posts
			trigger_when = "[TradeMarketWindow.IsTradePostsRequested]"
			on_start = "[GetVariableSystem.Set( 'market_subwindow', 'trade_posts' )]"
			on_start = "[TradeMarketWindow.SetTradePostsRequested( '(bool)no' )]"
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			layoutpolicy_vertical = expanding

			oncreate = "[BindFoldOutContext]"
			oncreate = "[PdxGuiFoldOut.SetShownBehavior( 'unfolded' )]"
			oncreate = "[PdxGuiFoldOut.Unfold]"

			hbox_trade_market_header = {}

			# Prosperity, Modifiers, and Trade Posts

			vbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				min_height = 310
				max_height = 500

				background = {
					texture = "gfx/interface/illustrations/event_scenes/gdp_italian_market.dds"
					fittype = centercrop
					alpha = 0.3
					using = Mask_Rough_Edges

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						mirror = vertical
					}

					modify_texture = {
						texture = "gfx/interface/component_masks/mask_fade_vertical.dds"
						blend_mode = alphamultiply
						mirror = vertical
					}
				}

				vbox = {
					datacontext = "[TradeGoodType.GetNeedCategory]"
					layoutpolicy_horizontal = expanding
					layoutpolicy_vertical = expanding

					# Category Banner
					hbox = {
						visible = "[TradeMarketWindow.HasSelectedTradeGoodType]"
						using = Animation_Market_Window_Refresh
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes
						margin = { 10 10 }
						margin_left = 20
						min_height = 48
						allow_outside = yes

						background = {
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							using = Background_Trade_Good_Banner_Right

							color = "[TradeGoodCategory.GetColor]"
							alpha = 0.85
							modify_texture = {
								texture = "gfx/interface/colors/grey.dds"
								blend_mode = overlay
								alpha = 0.2
							}
						}

						hbox = {
							spacing = 10

							widget = {
								size = { 28 34 }
								allow_outside = yes

								icon = {
									parentanchor = center
									size = { 38 60 }
									texture = "gfx/interface/icons/banners/republic_banner_category_bg.dds"
									color = "[TradeGoodCategory.GetColor]"
									alwaystransparent = yes
								}

								icon = {
									parentanchor = center
									size = { 18 18 }
									position = { 0 -2 }
									texture = "[TradeGoodCategory.GetSmallIcon]"
									tooltipwidget = trade_good_category_type_tooltip
								}
							}

							icon = {
								size = { 40 40 }
								allow_outside = yes
								texture = "[TradeGoodType.GetIcon]"
								tooltipwidget = trade_good_type_tooltip
							}

							text_single = {
								text = "[TradeGoodType.GetNameNoTooltip]"
								align = nobaseline
								max_width = 160
								using = Font_Size_Medium
							}
						}

						expand = {}

						vbox = {
							visible = "[Or( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ), TradeMarketWindow.HasSellingSide )]"
							spacing = 2
							ignoreinvisible = yes

							hbox_trade_market_good_flow = {
								visible = "[TradeMarketWindow.ShowsSurplusFlowForGood( TradeGoodType.Self )]"

								blockoverride "flow_label" {
									text = "TRADE_WINDOW_SURPLUS_LABEL"
								}
								blockoverride "flow_amount" {
									text = "[GetColoredValueString( TradeMarketWindow.GetSurplusFlowForGood( TradeGoodType.Self ), 'trade', '(int32)0' )]"
								}
								blockoverride "flow_price" {
									text = "[TradeMarket.GetBuyPriceForGood( TradeGoodType.Self, GetPlayer )|3]"
								}

								tooltipwidget = {
									widget_value_breakdown_tooltip = {
										datacontext = "[TradeMarket.GetBuyPriceDescForGood( TradeGoodType.Self, GetPlayer )]"
									}
								}
							}

							hbox_trade_market_good_flow = {
								visible = "[Not( TradeMarketWindow.ShowsSurplusFlowForGood( TradeGoodType.Self ) )]"

								blockoverride "flow_label" {
									text = "TRADE_WINDOW_DEFICIT_LABEL"
								}
								blockoverride "flow_amount" {
									text = "[TradeMarketWindow.GetDeficitFlowForGood( TradeGoodType.Self )]"
									default_format = "#trade_need"
								}
								blockoverride "flow_category_deficit" {
									hbox = {
										visible = "[GreaterThan_CFixedPoint( TradeMarketWindow.GetCategoryDeficitFlowForGood( TradeGoodType.Self ), '(CFixedPoint)0' )]"
										margin = { 15 5 }
										spacing = 6
										tooltipwidget = { widget_trade_category_needs_tooltip = {} }

										background = {
											using = Background_Area_Dark
											alpha = 0.6
										}

										icon = {
											size = { 20 20 }
											texture = "[TradeGoodCategory.GetSmallIcon]"
										}

										text_single = {
											text = "[TradeMarketWindow.GetCategoryDeficitFlowForGood( TradeGoodType.Self )|1^]"
											align = nobaseline
											default_format = "#trade_need"
										}
									}
								}
								blockoverride "flow_price" {
									text = "[TradeMarket.GetSellPriceForGood( TradeGoodType.Self, GetPlayer )|3]"
								}

								tooltipwidget = {
									widget_value_breakdown_tooltip = {
										datacontext = "[TradeMarket.GetSellPriceDescForGood( TradeGoodType.Self, GetPlayer )]"
									}
								}
							}

						}

						expand = {
							visible = "[Not( Or( TradeMarket.HasTradeBalanceForGood( TradeGoodType.Self ), TradeMarketWindow.HasSellingSide ) )]"
						}
					}

					# Tabs
					hbox = {
						visible = "[TradeMarketWindow.HasSelectedTradeGoodType]"
						layoutpolicy_horizontal = expanding
						ignoreinvisible = yes


						button_tab = {
							shortcut = "tab_1"
							onclick = "[TradeMarketWindow.SetShowNeeds]"
							down = "[TradeMarketWindow.IsShowingNeeds]"
							alwaystransparent = "[TradeMarketWindow.IsShowingNeeds]"

							blockoverride "tab_label" {
								text = "MARKET_WINDOW_GOOD_NEEDS_TITLE"
								max_width = 140
							}

							blockoverride "icon_visible" {}

							blockoverride "tab_icon" {
								texture = "gfx/interface/icons/flat_icons/domain.dds"
								size = { 28 28 }
								down = "[TradeMarketWindow.IsShowingNeeds]"
							}
						}

						button_tab = {
							shortcut = "tab_2"
							enabled = "[TradeMarketWindow.HasBuyingSide]"
							onclick = "[TradeMarketWindow.SetShowBuyers]"
							down = "[TradeMarketWindow.IsShowingBuyers]"
							alwaystransparent = "[TradeMarketWindow.IsShowingBuyers]"

							tooltip = "MARKET_WINDOW_GOOD_BUYERS_NONE_TT"
							using = tooltip_ne
							tooltip_visible = "[Not( TradeMarketWindow.HasBuyingSide )]"

							blockoverride "tab_label" {
								text = "[SelectLocalization( TradeMarketWindow.HasBuyingSide, 'MARKET_WINDOW_GOOD_BUYERS_TITLE', 'MARKET_WINDOW_GOOD_BUYERS_TITLE_OFF' )]"
								max_width = 140
								alpha = "[Select_float( TradeMarketWindow.HasBuyingSide, '(float)1.0', '(float)0.5' )]"
							}

							blockoverride "icon_visible" {}

							blockoverride "tab_icon" {
								texture = "gfx/interface/icons/flat_icons/arrow_down.dds"
								size = { 28 28 }
								down = "[TradeMarketWindow.IsShowingBuyers]"
							}
						}

						button_tab = {
							shortcut = "tab_3"
							enabled = "[TradeMarketWindow.HasSellingSide]"
							onclick = "[TradeMarketWindow.SetShowSellers]"
							down = "[TradeMarketWindow.IsShowingSellers]"
							alwaystransparent = "[TradeMarketWindow.IsShowingSellers]"

							tooltip = "MARKET_WINDOW_GOOD_SELLERS_NONE_TT"
							using = tooltip_ne
							tooltip_visible = "[Not( TradeMarketWindow.HasSellingSide )]"

							blockoverride "tab_label" {
								text = "[SelectLocalization( TradeMarketWindow.HasSellingSide, 'MARKET_WINDOW_GOOD_SELLERS_TITLE', 'MARKET_WINDOW_GOOD_SELLERS_TITLE_OFF' )]"
								max_width = 140
								alpha = "[Select_float( TradeMarketWindow.HasSellingSide, '(float)1.0', '(float)0.5' )]"
							}

							blockoverride "icon_visible" {}

							blockoverride "tab_icon" {
								texture = "gfx/interface/icons/flat_icons/arrow_up.dds"
								size = { 28 28 }
								down = "[TradeMarketWindow.IsShowingSellers]"
							}
						}
					}

					vbox = {
						visible = "[TradeMarketWindow.HasSelectedTradeGoodType]"
						layoutpolicy_vertical = expanding
						layoutpolicy_horizontal = expanding

						min_height = 213

						hbox = {
							visible = "[Or( TradeMarketWindow.IsShowingBuyers, TradeMarketWindow.IsShowingSellers )]"
							using = Animation_Tab_Switch
							using = Animation_Market_Window_Refresh
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding
							margin = { 14 5 }
							margin_top = 3
							spacing = 10


							widget = {
								size = { 150 190 }

								vbox = {
									size = { 100% 100% }
									margin_bottom = 12
									spacing = 16

									background = {
										using = Background_Area
										alpha = 0.9
									}

									expand = {}

									# Market share belongs to Profit Route owners; Rulers compete for none of it.
									vbox = {
										visible = "[GetPlayer.CanCreateProfitTradeRoutes]"
										spacing = 4

										hbox = {
											spacing = 8

											icon = {
												size = { 26 26 }
												texture = "[TradeGoodType.GetSmallIcon]"
											}

											text_single = {
												datacontext = "[TradeMarketWindow.GetPlayerCompetitivenessTooltip]"
												visible = "[TradeMarketWindow.PlayerHasRoutesForActiveSide]"
												max_width = 55


												text = "[TradeMarketWindow.GetActualShareForActiveSide( GetPlayer )|%0]"
												tooltipwidget = { widget_value_breakdown_tooltip = {} }
												tooltip_visible = "[ValueBreakdown.HasTooltip]"
												align = nobaseline
												using = Font_Size_Big
											}

											text_single = {
												datacontext = "[TradeMarketWindow.GetPlayerCompetitivenessTooltip]"
												visible = "[Not( TradeMarketWindow.PlayerHasRoutesForActiveSide )]"
												max_width = 55

												text = "[TradeMarketWindow.GetPlayerPotentialShareForActiveSide.GetShare|%0]"
												tooltipwidget = { widget_value_breakdown_tooltip = {} }
												tooltip_visible = "[ValueBreakdown.HasTooltip]"
												alpha = 0.5
												align = nobaseline
												using = Font_Size_Big
											}

											flowcontainer_trade_market_share_pie = {
												datacontext = "[TradeMarketWindow.GetPlayerShareForActiveSide]"
												visible = "[TradeMarketShare.IsContested]"
												tooltipwidget = {
													widget_trade_market_share_tooltip = {
														blockoverride "explanation" {
															text_multi = {
																visible = "[Not( TradeMarketWindow.PlayerHasRoutesForActiveSide )]"
																layoutpolicy_horizontal = expanding
																autoresize = yes
																max_width = 290
																text = "TRADE_MARKET_SHARE_TT_EXPLANATION"
															}
														}
													}
												}
											}
										}

										hbox = {
											visible = "[TradeMarketWindow.PlayerHasRoutesForActiveSide]"
											spacing = 8

											icon = {
												size = { 26 26 }
												texture = "gfx/interface/icons/trade/icon_trade_route.dds"
											}

											text_single = {
												max_width = 55
												text = "[TradeMarketWindow.GetPlayerRouteCountForActiveSide]"
												align = nobaseline
												using = Font_Size_Medium
											}
										}

										text_multi = {
											visible = "[TradeMarketWindow.PlayerHasRoutesForActiveSide]"
											autoresize = yes
											max_width = 100
											min_width = 100
											text = "MARKET_WINDOW_YOUR_MARKET_SHARE"
											align = center
										}

										text_multi = {
											visible = "[Not( TradeMarketWindow.PlayerHasRoutesForActiveSide )]"
											autoresize = yes
											max_width = 100
											min_width = 100
											text = "MARKET_WINDOW_POTENTIAL_MARKET_SHARE"
											align = center
										}
									}

									container = {
										visible = "[GetPlayer.CanCreateProfitTradeRoutes]"
										ignoreinvisible = yes

										widget_trade_monopoly_icon = {
											datacontext = "[TradeMarket.GetGoodMonopoly( TradeGoodType.Self )]"
											visible = "[TradeMarket.GoodIsUnderMonopoly( TradeGoodType.Self )]"
										}

										container_monopoly_access = {
											datacontext = "[TradeMarket.GetGoodMonopoly( TradeGoodType.Self )]"
											position = { 5 5 }
											blockoverride "check_size" {
												size = { 26 26 }
											}
										}
									}

									# Empty State for non-profit route creating characters
									text_multi = {
										visible = "[Not( GetPlayer.CanCreateProfitTradeRoutes )]"
										autoresize = yes
										max_width = 110
										min_width = 100
										text = "MARKET_WINDOW_NO_PROFIT_ROUTES"
										default_format = "#weak"
										align = center
									}

									expand = {}
								}
							}

							divider_light = {
								layoutpolicy_vertical = expanding
							}

							text_multi = {
								visible = "[And( TradeMarketWindow.IsShowingSellers, IsDataModelEmpty( TradeMarketWindow.GetActiveSideMerchants ) )]"
								layoutpolicy_horizontal = expanding
								autoresize = yes
								max_width = 500

								text = "MARKET_WINDOW_NO_TRADERS_SELLING"
								default_format = "#weak"
								align = center
							}

							text_multi = {
								visible = "[And( TradeMarketWindow.IsShowingBuyers, IsDataModelEmpty( TradeMarketWindow.GetActiveSideMerchants ) )]"
								layoutpolicy_horizontal = expanding
								autoresize = yes
								max_width = 500

								text = "MARKET_WINDOW_NO_TRADERS_BUYING"
								default_format = "#weak"
								align = center
							}

							vbox = {
								visible = "[DataModelHasItems( TradeMarketWindow.GetActiveSideMerchants )]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								spacing = 8
								margin_top = 8


								button_tertiary = {
									layoutpolicy_horizontal = expanding

									onclick = "[GetVariableSystem.SetOrToggle( 'market_subwindow', 'traders' )]"
									down = "[GetVariableSystem.HasValue( 'market_subwindow', 'traders' )]"

									align = left|nobaseline
									margin_right = 80

									text_single = {
										visible = "[TradeMarketWindow.IsShowingBuyers]"
										size = { 100% 100% }
										margin_left = 10
										margin_top = 3
										margin_right = 90

										text = "MARKET_WINDOW_BUYERS_IN_GOOD"
										default_format = "#clickable"
									}

									text_single = {
										visible = "[TradeMarketWindow.IsShowingSellers]"
										size = { 100% 100% }
										margin_left = 10
										margin_top = 3
										margin_right = 90

										text = "MARKET_WINDOW_SELLERS_IN_GOOD"
										default_format = "#clickable"
									}

									flowcontainer = {
										parentanchor = right|vcenter
										margin = { 7 0 }

										text_single = {
											text = "MARKET_WINDOW_ALL_TRADERS"

											align = nobaseline
											default_format = "#clickable"
										}

										button_select_arrow = {
											size = { 20 20 }
											alwaystransparent = yes
										}
									}
								}

								hbox = {
									layoutpolicy_horizontal = expanding

									fixedgridbox = {
										addcolumn = 98
										addrow = 135
										flipdirection = yes
										datamodel_wrap = 4

										datamodel = "[DataModelFirst( TradeMarketWindow.GetActiveSideMerchants, Min_int32( '(int32)8', GetDataModelSize( TradeMarketWindow.GetActiveSideMerchants ) ) )]"

										item = {
											widget = {
												size = { 85 146 }

												vbox = {
													datacontext = "[TradeMarketMerchant.GetMerchant]"

													widget = {
														layoutpolicy_horizontal = expanding
														size = { 0 26 }

														hbox = {
															parentanchor = center
															spacing = 1

															background = {
																using = Background_Area_Dark
																alpha = 0.5
																margin = { 1 5 }
																margin_bottom = 2
															}

															hbox_trade_market_merchant_competitiveness = {}
															hbox_trade_market_merchant_traded_amount = {}
														}
													}

													portrait_head_small = {}

													widget = {
														layoutpolicy_horizontal = expanding
														size = { 0 30 }

														icon_house_relation = {
															datacontext = "[Character.GetHouse]"
															datacontext = "[DynastyHouse.GetHouseRelationWith( GetPlayer.GetHouse )]"
															parentanchor = hcenter
															position = { 0 -15 }
															size = { 30 30 }

															tooltipwidget = {
																house_relation_item_tooltip_no_progressbar = {
																	blockoverride "description_prefix" {
																		text_single = {
																			layoutpolicy_horizontal = expanding
																			text = "house_relation_your_relation_with"
																			default_format = "#weak"
																			align = left
																		}
																	}
																}
															}
														}
													}
												}
											}
										}
									}

									expand = {}
								}

								expand = {}
							}
						}

						vbox = {
							visible = "[TradeMarketWindow.IsShowingNeeds]"
							using = Animation_Tab_Switch
							using = Animation_Market_Window_Refresh
							layoutpolicy_horizontal = expanding
							layoutpolicy_vertical = expanding

							margin = { 0 5 }
							margin_top = 3


							vbox_market_holding_needs = {
								layoutpolicy_vertical = expanding

								blockoverride "needs_scrollbox_size" {
									layoutpolicy_vertical = expanding
								}

								blockoverride "no_need_message_width" {
									max_width = 520
								}
							}
						}
					}

					text_single = {
						visible = "[Not( TradeMarketWindow.HasSelectedTradeGoodType )]"
						layoutpolicy_vertical = expanding

						text = "MARKET_WINDOW_SELECT_GOOD"
						default_format = "#weak"
					}
				}
			}

			vbox = {
				name = "market_balances_tutorial_uses_this"
				layoutpolicy_horizontal = expanding
				min_width = 580
				margin = { 4 0 }

				vbox = {
					layoutpolicy_horizontal = expanding
					expand = {}

					widget = {
						layoutpolicy_horizontal = expanding
						size = { 0 32 }
						text_label_center = {
							autoresize = no
							size = { 100% 100% }
							align = center
							text = "MARKET_WINDOW_TRADE_BASIC_GOODS"
						}
						market_balance_mode_toggle = {
							parentanchor = right|vcenter
							margin_right = 10
						}
					}
					spacer = {
						size = { 0 10 }
					}
				}

				hbox = {
					layoutpolicy_horizontal = expanding

					# First 4 Basic Goods
					vbox = {
						datamodel = "[DataModelFirst( GetBasicNeedTradeGoodCategories, '(int32)4' )]"
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						minimumsize = { 280 0 }
						spacing = 3

						item = {
							hbox_trade_market_need_category = {}
						}
					}

					spacer = { size = { 3 0 } }

					vbox = {
						layoutpolicy_vertical = expanding
						margin = { 0 -10 }
						icon = {
							layoutpolicy_vertical = expanding
							texture = "gfx/interface/colors/black.dds"
							spriteType = Corneredtiled
							size = { 9 4 }
							alpha = 0.4

							## EDGE FADE
							modify_texture = {
								texture = "gfx/interface/component_masks/mask_edge_3px.dds"
								spriteType = Corneredtiled
								spriteborder = { 4 4 }
								blend_mode = alphamultiply
							}

							### SCRATCHES
							modify_texture = {
								texture = "gfx/interface/component_masks/mask_scratches.dds"
								spriteType = Corneredtiled
								spriteborder = { 0 0 }
								blend_mode = alphamultiply
							}
						}
					}

					spacer = { size = { 3 0 } }

					# Last 4 Basic Goods
					vbox = {
						layoutpolicy_horizontal = expanding
						minimumsize = { 280 0 }
						spacing = 3

						vbox = {
							datamodel = "[DataModelSkipFirst( GetBasicNeedTradeGoodCategories, '(int32)4' )]"
							layoutpolicy_horizontal = expanding
							spacing = 3

							item = {
								hbox_trade_market_need_category = {}
							}
						}

						hbox_trade_market_misc_goods = {
							minimumsize = { 0 30 }
							margin_bottom = 4

							blockoverride "misc_goods_visible" {
								visible = "[Or( TradeMarket.AnyBasicAloneGoodHasBalance, Not( GetVariableSystem.Exists( 'market_show_all_goods' ) ) )]"
							}

							blockoverride "misc_goods_datamodel" {
								datamodel = "[GetBasicTradeGoodsAloneInNeedCategory]"
							}
						}
					}
				}

				spacer = { size = { 0 10 } }

				vbox = {
					layoutpolicy_horizontal = expanding

					expand = {}

					text_label_center = {
						layoutpolicy_horizontal = expanding
						margin = { 0 5 }
						align = center|nobaseline
						text = "MARKET_WINDOW_TRADE_GOODS"
					}
				}

				spacer = { size = { 0 10 } }

				hbox = {
					layoutpolicy_horizontal = expanding

					hbox = {
						datamodel = "[DataModelSkipFirst( DataModelFirst( GetNonBasicNeedTradeGoodCategories, '(int32)3' ), '(int32)2' )]"
						layoutpolicy_horizontal = expanding

						item = {
							hbox_trade_market_need_category = {}
						}
					}

					vbox = {
						layoutpolicy_vertical = expanding
						margin = { 4 0 }
						icon = {
							layoutpolicy_vertical = expanding
							texture = "gfx/interface/colors/black.dds"
							spriteType = Corneredtiled
							size = { 8 0 }
							alpha = 0.4

							## EDGE FADE
							modify_texture = {
								texture = "gfx/interface/component_masks/mask_edge_3px.dds"
								spriteType = Corneredtiled
								spriteborder = { 4 4 }
								blend_mode = alphamultiply
							}

							### SCRATCHES
							modify_texture = {
								texture = "gfx/interface/component_masks/mask_scratches.dds"
								spriteType = Corneredtiled
								spriteborder = { 0 0 }
								blend_mode = alphamultiply
							}
						}
					}

					hbox = {
						datamodel = "[DataModelSkipFirst( DataModelFirst( GetNonBasicNeedTradeGoodCategories, '(int32)4' ), '(int32)3' )]"
						layoutpolicy_horizontal = expanding

						item = {
							hbox_trade_market_need_category = {}
						}
					}
				}


				hbox = {
					layoutpolicy_horizontal = expanding
					margin_bottom = 4

					icon = {
						layoutpolicy_horizontal = expanding
						texture = "gfx/interface/colors/black.dds"
						spriteType = Corneredtiled
						size = { 0 8 }
						alpha = 0.4

						## EDGE FADE
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_edge_3px.dds"
							spriteType = Corneredtiled
							spriteborder = { 4 4 }
							blend_mode = alphamultiply
						}

						### SCRATCHES
						modify_texture = {
							texture = "gfx/interface/component_masks/mask_scratches.dds"
							spriteType = Corneredtiled
							spriteborder = { 0 0 }
							blend_mode = alphamultiply
						}
					}
				}


				vbox = {
					datamodel = "[DataModelFirst( GetNonBasicNeedTradeGoodCategories, '(int32)1' )]"
					layoutpolicy_horizontal = expanding
					spacing = 5

					item = {
						hbox_trade_market_need_category = {}
					}
				}

				vbox = {
					datamodel = "[DataModelSkipFirst( GetNonBasicNeedTradeGoodCategories, '(int32)4' )]"
					layoutpolicy_horizontal = expanding
					spacing = 2

					item = {
						hbox_trade_market_need_category = {}
					}
				}

				hbox_trade_market_misc_goods = {
					blockoverride "misc_goods_visible" {
						visible = "[Or( TradeMarket.AnyNonBasicAloneGoodHasBalance, Not( GetVariableSystem.Exists( 'market_show_all_goods' ) ) )]"
					}

					blockoverride "misc_goods_datamodel" {
						datamodel = "[GetNonBasicTradeGoodsAloneInNeedCategory]"
					}
				}
			}

			# Market Holder
			hbox = {
				datacontext = "[TradeMarket.GetLocationTitle.GetProvince.GetHolding]"
				datacontext = "[TradeMarket.GetLocationTitle.GetHolder]"
				layoutpolicy_horizontal = expanding

				min_height = 80
				background = {
					using = Background_Area
				}

				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 8 8 }

					portrait_head_small = {}

					vbox = {
						layoutpolicy_horizontal = expanding
						margin_left = 8

						text_single = {
							text = "TRADE_MARKET_OWNER_LABEL"
							layoutpolicy_horizontal = expanding
							autoresize = no
						}

						text_single = {
							text = "TRADE_MARKET_OWNER_NAME"
							layoutpolicy_horizontal = expanding
							autoresize = no
						}

						text_single = {
							text = "TRADE_MARKET_CAPITAL_LABEL"
							layoutpolicy_horizontal = expanding
							autoresize = no
						}
					}

					button_round = {
						visible = "[And3( Character.IsValid, Not( IsObserver ), GetPlayer.CanCreateProfitTradeRoutes )]"

						onclick = "[ToggleFilteredCharacterInteractionMenu( Character.Self, 'market_owner' )]"
						tooltip = "MARKET_OWNER_INTERACTIONS_BUTTON_TOOLTIP"
						tooltip_visible = "[Not( IsInteractionMenuOpenForCharacterWithFilter( Character.Self, 'market_owner') )]"

						button_icon = {
							alwaystransparent = yes
							parentanchor = center
							size = { 30 30 }
							texture = "gfx/interface/icons/flat_icons/character_interactions.dds"
						}

						text_single = {
							parentanchor = bottom|hcenter
							position = { 0 3 }

							text = "[GetNumberOfValidInteractionsWithFilter( Character.Self, 'market_owner' )]"
							default_format = "#glow_color:{0.1,0.1,0.1,1.0}"

							background = {
								margin = { 5 0 }
								margin_top = -5
								using = Background_Area_Dark
							}
						}
					}
					# Timed Modifiers
					hbox = {
						spacing = 3

						flowcontainer = {
							datamodel = "[DataModelFirst( TradeMarketWindow.GetTimedModifiers, Min_int32( GetDataModelSize( TradeMarketWindow.GetTimedModifiers ), '(int32)4' ) )]"
							visible = "[DataModelHasItems( TradeMarketWindow.GetTimedModifiers )]"
							spacing = 2
							ignoreinvisible = yes

							item = {
								modifier_item_icon = {
									size = { 24 24 }

									blockoverride "icon_data" {
										using = tooltip_ne
									}
								}
							}
						}

						text_single = {
							visible = "[GreaterThan_int32( GetDataModelSize( TradeMarketWindow.GetTimedModifiers ), '(int32)4' )]"
							min_width = 30
							max_width = 30

							raw_text = "+[Subtract_int32( GetDataModelSize( TradeMarketWindow.GetTimedModifiers ), '(int32)4' )]"
							align = center|nobaseline
							using = tooltip_se

							tooltipwidget = {
								scrolltip = {
									blockoverride "scrolltip_header" {
										text_single = {
											margin_top = 8
											text = "MARKET_WINDOW_ALL_MODIFIERS"
										}
									}
									blockoverride "scrolltip_size" {
										size = { 200 0 }
									}
									blockoverride "scrolltip_content" {
										flowcontainer = {
											direction = vertical
											datamodel = "[TradeMarketWindow.GetTimedModifiers]"
											spacing = 3

											item = {
												flowcontainer = {
													spacing = 5

													modifier_item_text = {}
												}
											}
										}
									}
								}
							}
						}
					}
				}
				vbox = {
					layoutpolicy_horizontal = expanding

					# Trade Posts
					hbox = {
						layoutpolicy_horizontal = expanding
						margin_top = 5

						expand = {}
						button_sidepanel_right = {
							size = { -1 40 }
							onclick = "[GetVariableSystem.SetOrToggle( 'market_subwindow', 'trade_posts' )]"
							alpha = "[Select_float( GreaterThan_int32( TradeMarket.GetCurrentTradePostCount, '(int32)0' ), '(float)1.0', '(float)0.5' )]"
							tooltip = "MARKET_WINDOW_TRADE_POSTS_TT"
							using = tooltip_sw

							blockoverride "button_text"
							{
								text = "MARKET_WINDOW_TRADE_POSTS"
								max_width = 180
							}
						}
					}

					# Profit Routes
					hbox = {
						layoutpolicy_horizontal = expanding

						expand = {}
						button_sidepanel_right = {
							size = { -1 40 }
							onclick = "[GetVariableSystem.SetOrToggle( 'market_subwindow', 'profit_routes' )]"
							alpha = "[Select_float( GreaterThan_int32( TradeMarket.GetProfitRouteCount, '(int32)0' ), '(float)1.0', '(float)0.5' )]"
							tooltip = "MARKET_WINDOW_PROFIT_ROUTES_TT"
							using = tooltip_sw

							blockoverride "button_text"
							{
								text = "MARKET_WINDOW_PROFIT_ROUTES"
								max_width = 180
							}
						}
					}

					# Distribution Routes
					hbox = {
						layoutpolicy_horizontal = expanding

						expand = {}
						button_sidepanel_right = {
							size = { -1 40 }
							margin_right = 6
							onclick = "[GetVariableSystem.SetOrToggle( 'market_subwindow', 'distribution_routes' )]"
							alpha = "[Select_float( GreaterThan_int32( TradeMarket.GetDistributionRouteCount, '(int32)0' ), '(float)1.0', '(float)0.5' )]"
							tooltip = "MARKET_WINDOW_DISTRIBUTION_ROUTES_TT"
							using = tooltip_sw

							blockoverride "button_text"
							{
								text = "MARKET_WINDOW_DISTRIBUTION_ROUTES"
							}
						}
					}
				}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				margin = { 12 8 }
				ignoreinvisible = yes
				min_height = 64

				# Prosperity
				hbox = {
					datacontext = "[TradeMarketWindow.GetAvgProsperityTooltip]"
					using = tooltip_se

					tooltipwidget = { widget_market_prosperity_breakdown_tooltip = {} }

					icon = {
						size = { 28 28 }
						texture = "gfx/interface/icons/prosperity.dds"
						alwaystransparent = yes
					}

					text_single = {
						text = "MARKET_WINDOW_AVERAGE_PROSPERITY"
						align = nobaseline
						alwaystransparent = yes
					}
				}

				expand = {}

				### TOLL LEVEL ###
				hbox = {
					spacing = 10
					ignoreinvisible = yes
					using = tooltip_se

					tooltipwidget = {
						widget_market_tolls_tooltip_main_window = {
							datacontext = "[GetPlayer]"
							datacontext = "[TradeMarket.GetTollLevel]"
						}
					}

					text_single = {
						text = "TOLL_CURRENT_INCOME"
						align = nobaseline
					}

					button_standard = {
						name = "toll_level_button"
						visible = "[TradeMarket.GetLocationTitle.GetHolder.IsLocalPlayer]"
						onclick = "[GetVariableSystem.SetOrToggle( 'market_subwindow', 'tolls' )]"
						down = "[GetVariableSystem.HasValue( 'market_subwindow', 'tolls' )]"
						size = { 160 40 }

						hbox = {
							datacontext = "[TradeMarket.GetTollLevelForCharacter( GetPlayer )]"
							margin = { 8 0 }
							alwaystransparent = yes

							toll_level_icon = {}

							text_single = {
								layoutpolicy_horizontal = expanding
								autoresize = no

								text = "[TollLevel.GetName]"
								align = nobaseline|center
								alwaystransparent = yes
							}

							button_replace = {
								size = { 24 24 }
								alwaystransparent = yes
							}
						}
					}

					hbox_market_toll = {
						datacontext = "[GetPlayer]"
						visible = "[And( Not( TradeMarket.GetLocationTitle.GetHolder.IsLocalPlayer ), CanPlayerUseProfitMode )]"
						blockoverride "toll_tooltip" {}
					}
				}
			}

			expand = {}
		}
	}

	### PROFIT ROUTES SUBWINDOW ###
	window = {
		visible = "[GetVariableSystem.HasValue( 'market_subwindow', 'profit_routes' )]"
		position = { 645 75 }
		size = { 500 80% }

		movable = yes

		using = Window_Background_Subwindow

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			on_finish = "[PdxGuiWidget.StackTop]"
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			margin = { 4 4 }
			spacing = 4

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "PROFIT_ROUTES_TITLE"
				}

