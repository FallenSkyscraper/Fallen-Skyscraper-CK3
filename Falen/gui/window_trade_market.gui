					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 8
						margin = { 6 3 }

						background = {
							using = Background_Area_Characterlist
						}

						text_single = {
							text = "[TradeMarketUnmetNeedBuilding.GetBuildingName]"
							align = nobaseline
						}

						text_single = {
							visible = "[TradeMarketUnmetNeedBuilding.IsDisabled]"
							text = "TRADE_MARKET_NEED_BUILDING_DISABLED"
							align = nobaseline
