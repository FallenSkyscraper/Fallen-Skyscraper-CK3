	type widget_trade_market_route_entry = widget {
		datacontext = "[TradeRouteItem.GetTradeRoute]"
		size = { 450 140 }

		hbox = {
			background = {
				using = Background_Area_Dark
				alpha = 0.3
			}

			background = {
				using = Background_Frame
			}

			background = {
				visible = "[TradeRoute.HasPrimaryGood]"
				using = Background_Trade_Good_Banner_Right
				margin_bottom = -95
				margin_left = -5
				margin_right = -60
				margin_top = -4
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding
				color = "[TradeRoute.GetPrimaryGood.GetNeedCategory.GetColor]"

				modify_texture = {
					texture = "gfx/interface/colors/grey.dds"
					blend_mode = overlay
					alpha = 0.2
				}

				modify_texture = {
					texture = "gfx/interface/component_masks/mask_fade_horizontal_extended.dds"
					blend_mode = alphamultiply
					mirror = horizontal
				}
			}

			background = {
				visible = "[And( Not( TradeRoute.HasPrimaryGood ), Not( TradeRoute.IsDistributionRoute ) )]"
				using = Background_Trade_Good_Banner_Right
				margin_bottom = -95
				margin_left = -5
				margin_right = -60
				margin_top = -4
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				modify_texture = {
					texture = "gfx/interface/colors/grey.dds"
					blend_mode = overlay
					alpha = 0.2
				}
			}

			background = {
				using = Background_Trade_Entry_Category
				visible = "[And( TradeRoute.HasPrimaryGood, Not( TradeRoute.IsDistributionRoute ) )]"
				color = "[TradeGoodCategory.GetColor]"
				alpha = 0.6
			}

			background = {
				using = Background_Trade_Entry_Pattern
				alpha = 0.3
				margin_top = -30
			}

			vbox = {
				layoutpolicy_horizontal = expanding
				margin = { 10 5 }


				text_single = {
					text = "[TradeRoute.GetNameNoTooltip]"
					layoutpolicy_horizontal = expanding
					autoresize = no

					align = left|nobaseline
					default_format = "#clickable"
					margin_left = 10
					margin_top = 10
				}


				spacer = { size = { 0 10 } }

				# Goods
				hbox = {
					layoutpolicy_horizontal = expanding
					margin = { 10 10 }

					flowcontainer = {
						ignoreinvisible = yes
						wrap_count = 8

						datamodel = "[TradeRoute.GetTradeGoods]"

						item = {
							icon = {
								visible = "[Or( Not( TradeRoute.IsDistributionRoute ), TradeRoute.HasAnyTransactionForGood( TradeGoodType.Self ) )]"
								size = { 40	40 }
								tooltipwidget = trade_good_type_tooltip
								texture = "[TradeGoodType.GetIcon]"
							}
						}
					}

					expand = {}
				}

				# Markets
				hbox = {
					layoutpolicy_horizontal = expanding
					allow_outside = yes

					hbox = {
						name = "used_stops"
						datamodel = "[TradeRouteItem.GetMarkets]"
						spacing = 7
						alwaystransparent = no
						margin = { 10 0 }

						item = {
							hbox = {
								datacontext = "[TradeMarketItem.GetTradeMarket]"
								tooltip = "TRADE_ROUTE_MARKET_STOP_TOOLTIP"
								using = tooltip_se

								button_icon = {
									size = { 22 22 }
									texture = "gfx/interface/icons/flat_icons/map_modes/trade_markets.dds"
									button_ignore = none
									using = TradeMarket_Mouse_Entry
									onclick = "[OpenGameViewData( 'trade_market_window', TradeMarket.Self )]"

									icon = {
										size = { 15 15 }
										parentanchor = top|right
										position = { 3 -3 }
										alwaystransparent = yes
										texture = "gfx/interface/icons/symbols/icon_alert.dds"
										visible = "[Not( IsDataModelEmpty( TradeMarketItem.GetBlockingMonopolies ) )]"
									}
								}
							}
						}
					}

					expand = {}

					# Profit
					vbox = {
						margin_top = -52
						allow_outside = yes

						hbox_market_toll = {
							datacontext = "[TradeRoute.GetOwner]"
							layoutpolicy_horizontal = expanding
						}

						spacer = {
							size = { 0 5 }
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							alwaystransparent = no
							tooltip = "TRADE_ROUTE_TOOLTIP_CAPACITY"
							using = tooltip_se

							icon = {
								size = { 26 26 }
								texture = "gfx/interface/icons/trade/icon_trade_capacity.dds"
								alwaystransparent = yes
							}

							text_single = {
								text = "TRADE_ROUTE_ENTRY_CAPACITY"
								align = nobaseline
								alwaystransparent = yes
							}

							expand = {}
						}

						hbox = {
							layoutpolicy_horizontal = expanding
							spacing = 5
							margin = { 0 5 }
							margin_right = 10

							text_single = {
								visible = "[And( Not( TradeRoute.IsDistributionRoute ), Not( TradeRoute.IsCommissionRoute ) )]"
								text = "TRADE_ROUTE_ENTRY_ACTUAL_PROFIT"
								align = nobaseline
								using = tooltip_se

								tooltipwidget = {
									trade_route_transactions_tooltip = {}
								}

								background = {
									margin_left = 40
									margin_right = 40
									# alpha = 0.5

									texture = "gfx/interface/component_tiles/tile_title_bg_01.dds"
									spriteType = Corneredtiled
									spriteborder = { 40 8 }
									texture_density = 2

									modify_texture = {
										name = "mask"
										texture = "gfx/interface/component_masks/mask_fade_horizontal_middle_thick.dds"
										spriteType = Corneredstretched
										spriteborder = { 0 0 }
										blend_mode = alphamultiply
									}
								}
							}

							expand = {}
						}
					}
				}

				expand = {}
			}

			# Route Owner
			vbox = {
				datacontext = "[TradeRoute.GetOwner]"
				layoutpolicy_vertical = expanding
				margin = { 10 5 }

				portrait_head_small = {}

				text_label_center = {
					text = "TRADE_POST_OWNER"
				}
			}
		}
	}

