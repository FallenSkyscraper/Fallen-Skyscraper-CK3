						expand = {}

						text_single = {
							visible = "[Not( TradeMarketUnmetNeedBuilding.IsDisabled )]"
							text = "[TradeMarketUnmetNeedBuilding.GetUnmetAmount|1^]"
							align = nobaseline
							default_format = "#trade_need"
						}
					}
				}
			}
		}
	}

	type widget_trade_good_balance_breakdown_tooltip = container {
		alwaystransparent = no

		object_tooltip_pop_out = {
			blockoverride "concept_link" {
				text = "[trade_good|E]"
			}

			blockoverride "header_additions" {
				hbox = {
					visible = "[TradeGoodType.HasIcon]"
					margin_right = 10

					icon = {
						size = { 40 40 }
						texture = "[TradeGoodType.GetIcon]"
					}
				}
			}

			blockoverride "title_text" {
				block "balance_header_text" {
					text = "TRADE_MARKET_BALANCE_TT_HEADER"
					default_format = "#T"
				}
			}

			blockoverride "main_description" {
				hbox = {
					datacontext = "[TradeMarket.GetTradeBalanceForGood( TradeGoodType.Self )]"
					layoutpolicy_horizontal = expanding

					# Column 1: Imports, Production, Distribution Imports, Entrepot Production
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2

						market_good_balance_cell = {
							blockoverride "balance_label" {
								text = "MARKET_GOOD_BALANCE_IMPORTS"
							}

							blockoverride "balance_value" {
								block "imports_value" {
									text = "MARKET_GOOD_BALANCE_IMPORTS_VALUE"
								}

								block "imports_breakdown" {
									default_format = "#trade_surplus"
								}
							}
						}

						market_good_balance_cell = {
							blockoverride "balance_label" {
								text = "MARKET_GOOD_BALANCE_PRODUCTION"
							}

							blockoverride "balance_value" {
								text = "MARKET_GOOD_BALANCE_PRODUCTION_VALUE"
								block "production_breakdown" {
									default_format = "#trade_surplus"
								}
							}
						}

						block "distribution_imports_row" {}

						block "entrepot_production_row" {}
					}

					# Column 2: Exports, Exploitative Exports, Building Needs, Distribution Exports, Entrepot Need
					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2

						market_good_balance_cell = {
							blockoverride "balance_label" {
								text = "MARKET_GOOD_BALANCE_EXPORTS"
							}

							blockoverride "balance_value" {
								block "exports_value" {
									text = "MARKET_GOOD_BALANCE_EXPORTS_VALUE"
								}

								block "exports_breakdown" {
									default_format = "#trade_need"
								}
							}
						}

						market_good_balance_cell = {
							visible = "[GreaterThan_CFixedPoint( TradeBalance.GetExploitativeExports, '(CFixedPoint)0' )]"
							tooltip = "MARKET_GOOD_BALANCE_EXPLOITATIVE_EXPORTS_TT"
							blockoverride "balance_label" {
								text = "MARKET_GOOD_BALANCE_EXPLOITATIVE_EXPORTS"
							}

							blockoverride "balance_value" {
								text = "MARKET_GOOD_BALANCE_EXPLOITATIVE_EXPORTS_VALUE"
								default_format = "#trade_need"
							}
						}

						block "building_needs_row" {}

						block "distribution_exports_row" {}

						block "entrepot_need_row" {}
					}
				}

				# Wide Column: Category Use and Unmet Needs Buildings
				block "category_use_row" {}

				spacer = {
					size = { 0 5 }
				}

				# The market window lists unmet holdings here
				# The map icon has no window in scope and shows the player's own need
				block "unmet_needs_section" {}

				spacer = {
					size = { 0 5 }
				}
			}
		}
	}

