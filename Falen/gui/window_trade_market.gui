	### TRADE POSTS SUBWINDOW ###
	window = {
		visible = "[GetVariableSystem.HasValue( 'market_subwindow', 'trade_posts' )]"
		position = { 645 75 }
		size = { 590 80% }

		movable = yes

		using = Window_Background_Subwindow

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			on_finish = "[PdxGuiWidget.StackTop]"
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			margin = { 4 4 }
			spacing = 4

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "TRADE_POSTS_TITLE"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear( 'market_subwindow' )]"
				}
			}

			text_multi = {
				text = "TRADE_POSTS_SUBTITLE"
				autoresize = yes
				max_width = 540
				align = nobaseline
			}

			spacer = {}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						datamodel = "[TradeMarket.GetTitles]"
						layoutpolicy_horizontal = expanding

						item = {
							widget = {
								datacontext = "[Title.GetProvince.GetHolding]"
								datacontext = "[Title.GetCountyData]"
								datacontext = "[AccessHoldingView]"

								visible = "[And( Title.IsCountyCapital, Holding.HasTradePostDistrictSlot )]"

								layoutpolicy_horizontal = expanding
								size = { 0 80 }

								background = {
									visible = "[Nor( Holding.HasConstructedTradePost, Holding.IsConstructingTradePost )]"

									using = Background_Area
								}

								vbox = {
									hbox = {
										margin = { 8 13 }
										spacing = 10
										layoutpolicy_horizontal = expanding

										background = {
											visible = "[Or( Holding.HasConstructedTradePost, Holding.IsConstructingTradePost )]"
											texture = "gfx/interface/component_masks/mask_rough_edges.dds"
											spriteType = Corneredtiled
											spriteborder = { 20 20 }
											color = { 0.8 0.8 1 0.2 }
											texture_density = 2
											alpha = 0.3
										}

										background = {
											visible = "[Or( Holding.HasConstructedTradePost, Holding.IsConstructingTradePost )]"
											using = Background_Frame
										}

										background = {
											visible = "[Nor( Holding.HasConstructedTradePost, Holding.IsConstructingTradePost )]"
											using = Background_Area_Dark
											alpha = 0.1
										}

										coa_title_small = {}

										button_standard = {
											name = "trade_post_district"
											visible = "[Or( Holding.HasConstructedTradePost, Holding.IsConstructingTradePost )]"
											datacontext = "[Holding.GetTradePostDistrict]"
											size = { 50 50 }
											# TODO_GDP_ART TIT-72439 add new frame to the trade post

											onclick = "[OpenGameViewData( 'holding_view', Holding.GetProvince )]"
											onclick = "[HoldingView.SetViewToTradePostDistrict]"

											highlight_icon_building = {
												parentanchor = center
												size = { 40 40 }
												texture = "gfx/interface/icons/building_types/district_buildings/trade_post_district.dds"
											}
										}


										button_standard = {
											name = "no_trade_post_district"
											visible = "[Nor( Holding.HasConstructedTradePost, Holding.IsConstructingTradePost )]"
											size = { 50 50 }
											tooltip = "TRADE_MARKET_CANNOT_HAVE_TRADE_POST_TT"
											tooltip_visible = "[And( GetPlayer.CanOwnTradePosts, Not( Holding.CanCharacterHaveTradePost( GetPlayer ) ) )]"
											onclick = "[OpenGameViewData( 'holding_view', Holding.GetProvince )]"
											onclick = "[HoldingView.SetViewToTradePostDistrict]"
											icon_empty_trade_post = {
												parentanchor = center
											}
											icon_flat_standard_gold = {
												name = "can_build_trade_post"
												visible = "[And3( Nor( Holding.HasConstructedTradePost, Holding.IsConstructingTradePost ), GetPlayer.CanOwnTradePosts, Holding.CanCharacterHaveTradePost( GetPlayer ) )]"
												parentanchor = center
												size = { 30 30 }
												alwaystransparent = yes
												texture = "gfx/interface/icons/flat_icons/plus.dds"
											}
										}

										hbox = {
											datacontext = "[Holding.GetTradePostTitle]"
											layoutpolicy_horizontal = expanding
											spacing = 4


											text_single = {
												autoresize = yes
												align = nobaseline
												text = "[County.GetTitle.GetNameNoTooltip]"
												background = {
													using = Text_Label_Background
													margin = { 10 3 }
												}
											}

											hbox = {
												visible = "[Holding.HasConstructedTradePost]"
												datacontext = "[Holding.GetTradePostTitle.GetHolder]"
												layoutpolicy_horizontal = expanding
												spacing = 6
												vbox = {
													layoutpolicy_horizontal = expanding
													text_single = {
														layoutpolicy_horizontal = expanding
														autoresize = no
														align = right|nobaseline
														text = "TRADE_POST_OWNER"
													}
													text_single = {
														layoutpolicy_horizontal = expanding
														autoresize = no
														align = right|nobaseline
														text = "[Title.GetName]"
													}
												}
												coa_house_tiny = {
													datacontext = "[Character.GetHouse]"
												}
											}
											text_single = {
												visible = "[And( Not( Holding.HasConstructedTradePost ), Holding.IsConstructingTradePost )]"
												layoutpolicy_horizontal = expanding
												autoresize = no
												margin_right = 8

												text = "TRADE_MARKET_CAPITAL_CONSTRUCTING_TRADE_POST"
												align = right|nobaseline
												default_format = "#weak"
											}

											text_single = {
												visible = "[Nor( Holding.HasConstructedTradePost, Holding.IsConstructingTradePost )]"
												layoutpolicy_horizontal = expanding
												autoresize = no
												margin_right = 8

												text = "TRADE_MARKET_CAPITAL_NO_TRADE_POST"
												align = right|nobaseline
												default_format = "#weak"
											}
										}
									}
								}
							}
						}
					}
				}
			}
		}
	}

	### TOLLS SIDE PANEL ###
	window = {
		name = "tolls_subwindow"
		datacontext = "[TradeMarketWindow.GetMarket]"
		visible = "[GetVariableSystem.HasValue( 'market_subwindow', 'tolls' )]"
		position = { 620 680 }
		size = { 400 280 }


		using = Window_Background_Subwindow

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			on_finish = "[PdxGuiWidget.StackTop]"
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			margin = { 4 4 }
			spacing = 5

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "TOLLS_WINDOW_TITLE"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear( 'market_subwindow' )]"
				}
			}

			hbox = {
				spacing = 12
				layoutpolicy_horizontal = expanding

				expand = {}

				background = {
					using = Background_Area_Dark
					alpha = 0.5
					margin = { -20 5 }
				}

				hbox = {
					spacing = 4
					datacontext = "[TradeMarket.GetTollLevelForCharacter( GetPlayer )]"
					toll_level_icon = {}

					text_single = {
						text = "TOLLS_MARKET_TOLL_LABEL"
						align = nobaseline
					}

				}

				hbox = {
					spacing = 8
					margin = { 4 4 }

					background = {
						using = Background_Area_Dark
						alpha = 0.5
					}

					button_select_arrow = {
						size = { 25 25 }
						mirror = horizontal
						enabled = "[GreaterThan_int32( TradeMarketWindow.GetSelectedTollIndex, '(int32)0' )]"
						onclick = "[TradeMarketWindow.SetSelectedTollIndex( Subtract_int32( TradeMarketWindow.GetSelectedTollIndex, '(int32)1' ) )]"
					}

					hbox = {
						minimumsize = { 80 0 }
						ignoreinvisible = yes
						datamodel = "[GetAllTollLevels]"

						item = {
							text_single = {
								visible = "[EqualTo_int32( TollLevel.GetDatabaseIndex, TradeMarketWindow.GetSelectedTollIndex )]"
								layoutpolicy_horizontal = expanding
								text = "[TollLevel.GetName]"
								align = center|nobaseline
							}
						}
					}

					button_select_arrow = {
						size = { 25 25 }
						enabled = "[LessThan_int32( TradeMarketWindow.GetSelectedTollIndex, Subtract_int32( GetDataModelSize( GetAllTollLevels ), '(int32)1' ) )]"
						onclick = "[TradeMarketWindow.SetSelectedTollIndex( Add_int32( TradeMarketWindow.GetSelectedTollIndex, '(int32)1' ) )]"
					}
				}

				expand = {}
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				background = {
					using = Background_Area
				}

				vbox = {
					min_width = 210
					margin = { 0 4 }
					spacing = 4
					layoutpolicy_vertical = expanding

					expand = {}

					hbox = {
						layoutpolicy_horizontal = expanding

						text_single = {
							text = "TOLLS_EFFECTS_LABEL"
							align = left|nobaseline
							default_format = "#low"
						}

						expand = {}
					}

					vbox = {
						datamodel = "[GetAllTollLevels]"
						ignoreinvisible = yes
						layoutpolicy_horizontal = expanding

						item = {
							vbox = {
								visible = "[EqualTo_int32( TollLevel.GetDatabaseIndex, TradeMarketWindow.GetSelectedTollIndex )]"
								layoutpolicy_horizontal = expanding
								layoutpolicy_vertical = expanding
								spacing = 4

								hbox = {
									layoutpolicy_horizontal = expanding

									text_single = {
										text = "TOLL_EFFECT_ROUTE_OWNER"
										align = left|nobaseline
									}

									expand = {}
								}

								hbox = {
									layoutpolicy_horizontal = expanding

									text_single = {
										text = "TOLL_EFFECT_MARKET_OWNER"
										align = left|nobaseline
									}

									expand = {}
								}

								text_single = {
									layoutpolicy_horizontal = expanding
									text = "TOLL_PREDICTED_INCOME"
								}
							}
						}
					}

					expand = {}
				}
			}

			hbox = {

				margin = { 0 8 }
				spacing = 8

				button_standard = {
					onclick = "[GetVariableSystem.Clear( 'market_subwindow' )]"
					text = "CANCEL_BUTTON"
				}

				button_primary = {
					enabled = "[IsValidCommand( TradeMarketWindow.ChangeTollLevelCommand )]"
					tooltip = "[GetCommandDesc( TradeMarketWindow.ChangeTollLevelCommand )]"
					onclick = "[CreateCommandPopup( TradeMarketWindow.ChangeTollLevelCommand )]"

					text = "CHANGE_TOLL_LEVEL_BUTTON"
				}
			}
		}
	}

	window = {
		datacontext = "[TradeMarketWindow.GetSelectedTradeGoodType]"
		visible = "[GetVariableSystem.HasValue( 'market_subwindow', 'traders' )]"
		position = { 645 75 }
		size = { 550 80% }
		movable = yes

		using = Window_Background_Subwindow

		state = {
			name = _show
			using = Animation_FadeIn_Quick
			using = Sound_WindowShow_Standard
			on_finish = "[PdxGuiWidget.StackTop]"
		}

		state = {
			name = _hide
			using = Animation_FadeOut_Quick
			using = Sound_WindowHide_Standard
		}

		vbox = {
			margin = { 4 4 }
			spacing = 4

			header_pattern = {
				layoutpolicy_horizontal = expanding

				blockoverride "header_text"
				{
					text = "MARKET_PROFIT_ROUTE_OWNERS_TITLE"
				}

				blockoverride "button_close"
				{
					onclick = "[GetVariableSystem.Clear( 'market_subwindow' )]"
				}
			}

			text_multi = {
				visible = "[TradeMarketWindow.IsShowingBuyers]"
				text = "MARKET_PROFIT_ROUTE_BUYERS_SUBTITLE"
				autoresize = yes
				max_width = 650
				align = nobaseline
			}

			text_multi = {
				visible = "[TradeMarketWindow.IsShowingSellers]"
				text = "MARKET_PROFIT_ROUTE_SELLERS_SUBTITLE"
				autoresize = yes
				max_width = 650
				align = nobaseline
			}

			hbox = {
				name = "merchants_sorting"
				layoutpolicy_horizontal = expanding
				margin = { 10 0 }
				spacing = 5

				button_standard = {
					name = "sort_order"
					size = { 25 25 }
					onclick = "[TradeMarketMerchantsList.ToggleSortOrder]"
					tooltip = "MERCHANTS_SORT_ORDER_TOOLTIP"

					using = tooltip_ne

					button_icon = {
						size = { 25 25 }
						texture = "gfx/interface/icons/flat_icons/sort_icon.dds"
						framesize = { 66 66 }
						frame = "[BoolTo2And1( TradeMarketWindow.IsMerchantsSortOrderDescending )]"

						alwaystransparent = yes

						blockoverride "button_frames"
						{
							effectname = "NoHighlight"
						}
					}
				}

				dropdown_menu_standard = {
					name = "sort_trade_market_merchants"

					blockoverride "dropdown_properties"
					{
						datamodel = "[TradeMarketMerchantsList.GetSortOptions]"
						onselectionchanged = "[TradeMarketMerchantsList.SortMerchants]"
						selectedindex = "[TradeMarketMerchantsList.GetSortOptionIndex]"
					}

					blockoverride "dropdown_active_item_properties"
					{
						text = "[Localize( CString.GetString )]"
					}

					blockoverride "dropdown_item_properties"
					{
						text = "[Localize( CString.GetString )]"
					}
				}

				expand = {}
			}

			scrollbox = {
				layoutpolicy_horizontal = expanding
				layoutpolicy_vertical = expanding

				blockoverride "scrollbox_content"
				{
					vbox = {
						datamodel = "[TradeMarketWindow.GetActiveSideMerchants]"
						layoutpolicy_horizontal = expanding
						spacing = 5

						item = {
							widget = {
								datacontext = "[TradeMarketMerchant.GetMerchant]"
								layoutpolicy_horizontal = expanding
								size = { 0 115 }

								background = {
									using = Background_Area_With_Header
								}

								background = {
									visible = "[And( Not( ObjectsEqual( TradeMarket.GetLocationTitle.GetHolder.GetTopLiege, Character.GetTopLiege ) ), Not( TradeMarket.IsHomeTradeMarketForMerchant( Character.Self ) ) )]"
									using = Background_Area
									alpha = 0.8
								}

								background = {
									using = Background_Frame
								}

								background = {
									visible = "[TradeMarketWindow.HasSelectedTradeGoodType]"
									using = Background_Trade_Good_Banner_Right
									margin_bottom = -77
									margin_left = -3
									margin_top = -2
									layoutpolicy_horizontal = expanding
									layoutpolicy_vertical = expanding
									color = "[TradeGoodType.GetNeedCategory.GetColor]"

									modify_texture = {
										texture = "gfx/interface/colors/grey.dds"
										blend_mode = overlay
										alpha = 0.2
									}
								}

								background = {
									visible = "[TradeMarketWindow.HasSelectedTradeGoodType]"
									using = Background_Trade_Entry_Category
									color = "[TradeGoodType.GetNeedCategory.GetColor]"
								}

								background = {
									using = Background_Trade_Entry_Pattern
									alpha = 0.4
									margin_top = -30
								}

								hbox = {
									layoutpolicy_horizontal = expanding
									spacing = 5

									vbox = {
										layoutpolicy_vertical = expanding
										margin = { 10 5 }
										portrait_head_small = {}
										expand = {}
									}

									vbox = {
										layoutpolicy_horizontal = expanding
										layoutpolicy_vertical = expanding
										margin_top = 8
										spacing = 4

										text_single = {
											align = nobaseline
											layoutpolicy_horizontal = expanding
											text = "[Character.GetUINameNotMeNoTooltip]"
										}

										hbox = {
											layoutpolicy_horizontal = expanding
											spacing = 4

											hbox_trade_market_merchant_traded_amount = {
												visible = "[TradeMarketWindow.HasSelectedTradeGoodType]"

												blockoverride "good_icon_size" {
													size = { 30 30 }
												}
											}

											hbox_trade_market_merchant_competitiveness = {}

											hbox = {
												spacing = 3

												tooltipwidget = {
													scrolltip = {
														blockoverride "scrolltip_header" {
															margin_top = 10

															hbox = {
																layoutpolicy_horizontal = expanding

																text_single = {
																	text = "PROFIT_ROUTE_OWNER_TT_HEADER"
																	align = nobaseline
																	default_format = "#T"
																}

																expand = {}
															}
														}

														blockoverride "scrolltip_content" {
															vbox = {
																datamodel = "[TradeMarketMerchant.GetSelectedGoodRoutes]"
																layoutpolicy_horizontal = expanding
																spacing = 3

																item = {
																	hbox = {
																		layoutpolicy_horizontal = expanding

																		# Route Name
																		text_single = {
																			text = "[TradeRoute.GetName]"
																			align = nobaseline
																			#default_format = "#T"
																		}

																		spacer = { size = { 5 0 } }

																		# Traded Goods
																		hbox = {
																			datamodel = "[TradeRoute.GetTradeGoods]"
																			spacing = 5

																			item = {
																				icon = {
																					visible = "[TradeRoute.HasAnyTransactionForGood( TradeGoodType.Self )]"
																					size = { 25 25 }
																					tooltipwidget = trade_good_type_tooltip_with_transactions
																					texture = "[TradeGoodType.GetSmallIcon]"
																				}
																			}
																		}

																		expand = {}
																	}
																}
															}
														}
													}
												}

												icon = {
													size = { 20 20 }
													texture = "gfx/interface/icons/trade/icon_trade_route.dds"
												}

												text_single = {
													text = "[TradeMarketMerchant.GetSelectedGoodRouteCount]"
													min_width = 10
													align = nobaseline
												}
											}

											text_single = {
												visible = "[TradeMarketMerchant.HasCommissionRouteInMarket]"
												layoutpolicy_horizontal = expanding
												autoresize = no
												size = { 0 22 }

												text = "MARKET_TRADER_ON_COMMISSION"
												default_format = "#low"
												align = nobaseline
											}

											text_single = {
												visible = "[And( Character.IsMerchant, TradeMarket.IsHomeTradeMarketForMerchant( Character.Self ) )]"
												layoutpolicy_horizontal = expanding
												autoresize = no
												size = { 0 22 }

												text = "THEIR_HOME_MARKET"
												default_format = "#low"
												align = nobaseline
											}

											hbox = {
												visible = "[Not( Character.IsMerchant )]"
												layoutpolicy_horizontal = expanding

												text_single = {
													visible = "[ObjectsEqual( TradeMarket.GetLocationTitle.GetHolder, Character.Self )]"
													layoutpolicy_horizontal = expanding
													autoresize = no
													size = { 0 22 }

													text = "THEY_ARE_MARKET_OWNER"
													align = nobaseline
												}

												text_single = {
													visible = "[And( Not( ObjectsEqual( TradeMarket.GetLocationTitle.GetHolder, Character.Self ) ), ObjectsEqual( TradeMarket.GetLocationTitle.GetHolder.GetTopLiege, Character.GetTopLiege ) )]"
													layoutpolicy_horizontal = expanding
													autoresize = no
													text = "THEIR_REALM_MARKET"
													default_format = "#low"
													align = nobaseline
												}
											}

											expand = {}

											hbox = {
												datacontext = "[Character.GetHouse]"
												datacontext = "[DynastyHouse.GetHouseRelationWith( GetPlayer.GetHouse )]"
												margin = { 4 0 }

												background = {
													using = Background_Area
												}


												hbox = {
													visible = "[HouseRelation.IsValid]"
													spacing = 4
													margin_left = 10

													tooltipwidget = {
														house_relation_item_tooltip_no_progressbar = {
															blockoverride "description_prefix" {
																text_single = {
																	layoutpolicy_horizontal = expanding
																	text = "house_relation_your_relation_with"
																	default_format = "#weak"
																	align = left
																}
															}
														}
													}

													text_single = {
														max_width = 150
														text = "[HouseRelation.GetLevel.GetNameNoTooltip]"
														align = nobaseline
													}

													icon_house_relation = {
														datacontext = "[Character.GetHouse]"
														size = { 30 30 }
													}
												}

												coa_house_tiny = {}
											}
										}


										expand = {}
									}
								}
							}
						}
					}
				}
			}
		}
	}
}

######################################################
################ TYPES AND TEMPLATES #################
######################################################

types TradeMarketTypes
{
	# datacontext: TradeMarketMerchant
	type hbox_trade_market_merchant_competitiveness = hbox {
		datacontext = "[TradeMarketMerchant.GetCompetitivenessTooltip]"
		spacing = 3
		tooltip_visible = "[ValueBreakdown.HasTooltip]"
		tooltipwidget = { widget_value_breakdown_tooltip = {} }

		icon = {
			size = { 20 20 }
			texture = "gfx/interface/icons/trade/icon_trade_competitiveness.dds"
			alwaystransparent = yes
		}

		text_single = {
			text = "[ValueBreakdown.GetValue|0]"
			min_width = 16
			align = nobaseline
			alwaystransparent = yes
		}
	}

	# What the merchant traded of the selected good here last month. datacontext: TradeMarketMerchant
	type hbox_trade_market_merchant_traded_amount = hbox {
		datacontext = "[TradeMarketMerchant.GetSelectedGoodShare]"
		spacing = 3
		tooltipwidget = { widget_trade_market_merchant_traded_amount_tooltip = {} }

		icon = {
			block "good_icon_size" {
				size = { 20 20 }
			}
			texture = "[TradeGoodType.GetIcon]"
			alwaystransparent = yes
		}

		text_single = {
			text = "[TradeMarketMerchant.GetSelectedGoodTradeAmount|1^]"
			min_width = 16
			align = nobaseline
			alwaystransparent = yes
		}
	}

	# datacontext: TradeMarketMerchant, TradeMarketShare
	type widget_trade_market_merchant_traded_amount_tooltip = widget {
		size = { 320 5 }
		using = DefaultTooltipBackground
		using = GeneralTooltipSetup
		alwaystransparent = no

		vbox = {
			datacontext = "[TradeMarketShare.GetGood]"
			layoutpolicy_horizontal = expanding
			resizeparent = yes
			margin = { 15 12 }
			spacing = 4
			ignoreinvisible = yes

			text_single = {
				visible = "[Not( TradeMarketShare.IsSell )]"
				layoutpolicy_horizontal = expanding
				text = "TRADE_MARKET_MERCHANT_TRADED_TT_BUYING"
			}

			text_single = {
				visible = "[TradeMarketShare.IsSell]"
				layoutpolicy_horizontal = expanding
				text = "TRADE_MARKET_MERCHANT_TRADED_TT_SELLING"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "TRADE_MARKET_MERCHANT_TRADED_TT_COMPETITIVENESS"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "TRADE_MARKET_MERCHANT_TRADED_TT_TOTAL_COMPETITIVENESS"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "TRADE_MARKET_MERCHANT_TRADED_TT_MARKET_SHARE"
			}

			text_single = {
				layoutpolicy_horizontal = expanding
				text = "TRADE_MARKET_MERCHANT_TRADED_TT_TRADABLE"
			}
		}
	}

	type hbox_trade_market_header = header_pattern  {
		name = "market_header"
		layoutpolicy_horizontal = expanding

		blockoverride "header_text" {
		}

		blockoverride "size" {
			size = { 100 60 }

		}

		blockoverride "button_go_to" {
			onclick = "[DefaultOnCoatOfArmsRightClick( TradeMarket.GetLocationTitle.GetDeJureLiege.GetDeJureLiege.GetID )]"
		}

		blockoverride "button_back" {
			visible = "[HasViewHistory]"
			onclick = "[OpenFromViewHistory]"
			tooltip = "[GetViewHistoryTooltip]"
		}

		blockoverride "button_close" {
			onclick = "[TradeMarketWindow.Close]"
		}

		vbox = {
			layoutpolicy_horizontal = expanding
			margin = { 10 0 }
			spacing = 2

			hbox = {
				layoutpolicy_horizontal = expanding

				text_single = {
					layoutpolicy_horizontal = expanding
					text = "[TradeMarket.GetNameNoTooltip|U]"
					using = Font_Size_Big
					font = TitleFont
					max_width = 380
					fontsize_min = 16
				}

				expand = {}
			}
		}
	}

	type market_balance_mode_toggle = hbox {
		layoutpolicy_horizontal = expanding
		spacing = 4

		expand = {}

		button_round = {
			size = { 32 32 }
			onclick = "[TradeMarketWindow.SetBalanceMode( '(bool)yes' )]"
			down = "[TradeMarketWindow.IsNetBalanceMode]"
			alwaystransparent = "[TradeMarketWindow.IsNetBalanceMode]"
			tooltip = "MARKET_BALANCE_MODE_NET_TOOLTIP"
			using = tooltip_ne
			button_icon = {
				size = { 20 20 }
				parentanchor = center
				alwaystransparent = yes
				down = "[TradeMarketWindow.IsNetBalanceMode]"
				texture = "gfx/interface/icons/flat_icons/net_gain.dds"
			}
		}
		button_round = {
			size = { 32 32 }
			onclick = "[TradeMarketWindow.SetBalanceMode( '(bool)no' )]"
			down = "[Not( TradeMarketWindow.IsNetBalanceMode )]"
			alwaystransparent = "[Not( TradeMarketWindow.IsNetBalanceMode )]"
			tooltip = "MARKET_BALANCE_MODE_TRADABLE_TOOLTIP"
			using = tooltip_ne
			button_icon = {
				size = { 20 20 }
				parentanchor = center
				alwaystransparent = yes
				down = "[Not( TradeMarketWindow.IsNetBalanceMode )]"
				texture = "gfx/interface/icons/flat_icons/tradable.dds"
			}
		}
	}

	type market_good_balance_cell = hbox {
		layoutpolicy_horizontal = expanding
		minimumsize = { 210 -1 }
		margin = { 10 5 }

		background = {
			using = Background_Area_Dark
			alpha = 0.5
		}

		text_single = {
			block "balance_label" {}
			align = nobaseline
			using = tooltip_es
		}

		expand = {}

		text_single = {
			margin_left = 10
			block "balance_value" {}
			align = nobaseline
			using = tooltip_es
		}
	}

	type trade_category_tooltip = object_tooltip_pop_out {
		blockoverride "concept_link" {
			text = "[trade_category|E]"
		}

		blockoverride "header_additions" {
			hbox = {
				visible = "[TradeGoodCategory.HasIcon]"
				margin_right = 10

				icon = {
					size = { 40 40 }
					texture = "[TradeGoodCategory.GetIcon]"
				}
			}
		}
	}

	type widget_trade_category_needs_tooltip = container {
		alwaystransparent = no

		trade_category_tooltip = {
			blockoverride "title_text" {
				text = "[TradeGoodCategory.GetName]"
				default_format = "#T"
			}

			blockoverride "main_description" {
				spacing = 5

				text_multi = {
					visible = "[Not( TradeMarketWindow.HasUnmetNeedsForCategory( TradeGoodCategory.Self ) )]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 300
					text = "MARKET_CATEGORY_NEEDS_ALL_MET"
					align = nobaseline
				}

				text_multi = {
					visible = "[TradeMarket.HasExploitingMonopolyForCategory( TradeGoodCategory.Self )]"
					datacontext = "[TradeMarket.GetExploitingMonopolyForCategory( TradeGoodCategory.Self )]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 300
					text = "MARKET_CATEGORY_EXPLOITED_LINE"
					align = nobaseline
				}

				market_good_balance_cell = {
					visible = "[TradeMarketWindow.HasUnmetNeedsForCategory( TradeGoodCategory.Self )]"
					blockoverride "balance_label" {
						text = "MARKET_GOOD_BALANCE_BUILDING_NEEDS"
					}

					blockoverride "balance_value" {
						text = "MARKET_CATEGORY_BALANCE_BUILDING_NEEDS_VALUE"
						default_format = "#trade_need"
					}
				}

				vbox = {
					visible = "[TradeMarketWindow.HasCategorySupplyGoods( TradeGoodCategory.Self )]"
					layoutpolicy_horizontal = expanding
					spacing = 2
					margin_top = 4

					text_single = {
						layoutpolicy_horizontal = expanding
						text = "MARKET_CATEGORY_SUPPLIED_BY_TITLE"
						align = nobaseline
					}

					vbox = {
						datamodel = "[TradeMarketWindow.GetCategorySupplyGoods( TradeGoodCategory.Self )]"
						layoutpolicy_horizontal = expanding
						spacing = 2

						item = {
							market_good_balance_cell = {
								blockoverride "balance_label" {
									text = "MARKET_CATEGORY_SUPPLIED_GOOD_LABEL"
								}

								blockoverride "balance_value" {
									text = "[TradeMarketWindow.GetCategoryUseForGood( TradeGoodType.Self )|1^]"
									align = nobaseline
									default_format = "#trade_surplus"
								}
							}
						}
					}
				}

				vbox = {
					visible = "[TradeMarketWindow.HasPlayerUnmetNeedsForCategory( TradeGoodCategory.Self )]"
					layoutpolicy_horizontal = expanding
					spacing = 2
					margin_top = 4

					hbox = {
						layoutpolicy_horizontal = expanding
						spacing = 6

						icon_flat_standard = {
							size = { 18 18 }
							texture = "gfx/interface/icons/flat_icons/domain.dds"
						}

						text_single = {
							layoutpolicy_horizontal = expanding
							text = "MARKET_CATEGORY_UNMET_NEEDS_TITLE"
							align = nobaseline
						}
					}

					vbox = {
						datamodel = "[TradeMarketWindow.GetPlayerUnmetNeedsForCategory( TradeGoodCategory.Self )]"
						layoutpolicy_horizontal = expanding
						spacing = 3

						item = {
							hbox = {
								layoutpolicy_horizontal = expanding
								spacing = 8
								margin = { 6 3 }

								tooltipwidget = {
									widget_trade_market_holding_needs_tooltip = {}
								}

								background = {
									using = Background_Area_Characterlist
								}

								text_single = {
									text = "[TradeMarketUnmetNeed.GetTitle.GetNameNoTierNoTooltip]"
									align = nobaseline
								}

								expand = {}

								text_single = {
									text = "[TradeMarketUnmetNeed.GetTotalUnmet|1^]"
									align = nobaseline
									default_format = "#trade_need"
								}

								text_single = {
									size = { 40 25 }
									autoresize = no
									text = "[TradeMarketUnmetNeed.GetMarketPriority|O]"
									default_format = "#light_background"
									align = nobaseline|center
									tooltip = "HOLDING_MARKET_PRIORITY_TT"

									using = Background_Letter_No_Frame
								}
							}
						}
					}
				}
			}
		}
	}

	type widget_trade_category_net_balance_breakdown_tooltip = container {
		# needed datacontext
		#TradeGoodCategory
		#TradeMarket
		alwaystransparent = no

		trade_category_tooltip = {
			blockoverride "title_text" {
				text = "MARKET_CATEGORY_BALANCE_HEADER_NEED"
				default_format = "#T"
			}

			blockoverride "main_description" {
				text_multi = {
					visible = "[TradeMarket.HasExploitingMonopolyForCategory( TradeGoodCategory.Self )]"
					datacontext = "[TradeMarket.GetExploitingMonopolyForCategory( TradeGoodCategory.Self )]"
					layoutpolicy_horizontal = expanding
					autoresize = yes
					max_width = 300
					text = "MARKET_CATEGORY_EXPLOITED_LINE"
					align = nobaseline
				}

				hbox = {
					layoutpolicy_horizontal = expanding

					vbox = {
						layoutpolicy_horizontal = expanding
						spacing = 2

						market_good_balance_cell = {
							blockoverride "balance_label" {
								text = "MARKET_GOOD_BALANCE_IMPORTS"
							}

							blockoverride "balance_value" {
								text = "MARKET_CATEGORY_NET_IMPORTS_VALUE"
								default_format = "#trade_surplus"
							}
						}

						market_good_balance_cell = {
							blockoverride "balance_label" {
								text = "MARKET_GOOD_BALANCE_PRODUCTION"
							}

							blockoverride "balance_value" {
								text = "MARKET_CATEGORY_NET_PRODUCTION_VALUE"
								default_format = "#trade_surplus"
							}
						}
					}

					vbox = {
						layoutpolicy_horizontal = expanding
						layoutpolicy_vertical = expanding
						spacing = 2

						market_good_balance_cell = {
							blockoverride "balance_label" {
								text = "MARKET_GOOD_BALANCE_BUILDING_NEEDS"
							}

							blockoverride "balance_value" {
								text = "MARKET_CATEGORY_NET_BUILDING_NEEDS_VALUE"
								default_format = "#trade_need"
							}
						}

						expand = {}
					}
				}
			}
		}
	}

	type widget_trade_market_holding_needs_tooltip = widget {
		size = { 50 50 }
		alwaystransparent = no
		using = GeneralTooltipSetup

		using = DefaultTooltipBackground

		vbox = {
			set_parent_size_to_minimum = yes
			layoutpolicy_horizontal = expanding
			margin = { 20 10 }
			spacing = 4

			text_single = {
				text = "[TradeMarketUnmetNeed.GetTitle.GetNameNoTierNoTooltip]"
				align = nobaseline
				default_format = "#T"
				layoutpolicy_horizontal = expanding
			}

			text_multi = {
				visible = "[TradeMarketUnmetNeed.IsExploited]"
				datacontext = "[TradeMarketUnmetNeed.GetExploitingMonopoly]"
				layoutpolicy_horizontal = expanding
				autoresize = yes
				max_width = 360
				text = "HOLDING_UNMET_NEEDS_EXPLOITED_LINE"
				align = nobaseline
			}

			hbox = {
				layoutpolicy_horizontal = expanding
				spacing = 6

				icon_flat_standard = {
					size = { 18 18 }
					texture = "gfx/interface/icons/flat_icons/domain.dds"
				}

				text_single = {
					visible = "[Not( TradeMarketUnmetNeed.IsCategory )]"
					layoutpolicy_horizontal = expanding
					datacontext = "[TradeMarketUnmetNeed.GetTradeGoodType]"
					text = "HOLDING_UNMET_NEEDS_BUILDINGS_TITLE"
					align = nobaseline
					default_format = "#weak"
				}

				text_single = {
					visible = "[TradeMarketUnmetNeed.IsCategory]"
					layoutpolicy_horizontal = expanding
					datacontext = "[TradeMarketUnmetNeed.GetCategory]"
					text = "HOLDING_UNMET_NEEDS_BUILDINGS_TITLE_CATEGORY"
					align = nobaseline
					default_format = "#weak"
